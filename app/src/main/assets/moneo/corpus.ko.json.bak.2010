  },
  {
   "id": 1091,
   "offset": 3944469,
   "text": "등!\n\n",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 1092,
   "offset": 3944473,
   "text": "효과는부족한듯……",
