   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 1084,
   "offset": 3944329,
   "text": "{var:0F}몬끔냈\n간끔룩같넥!",
   "unknown": 0,
   "hangul": 8
  },
  {
   "id": 1085,
   "offset": 3944350,
   "text": "{var:10}몬끔냈\n간끔룩갚네!",
   "unknown": 0,
   "hangul": 8
  },
  {
   "id": 1086,
   "offset": 3944371,
   "text": "급소에맟았다!",
   "unknown": 0,
   "hangul": 6
  },
  {
