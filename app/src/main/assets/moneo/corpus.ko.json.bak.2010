  },
  {
   "id": 5271,
   "offset": 4292710,
   "text": "데",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 5272,
   "offset": 4292712,
   "text": "□넣끓!\n견템깃!데",
   "unknown": 1,
