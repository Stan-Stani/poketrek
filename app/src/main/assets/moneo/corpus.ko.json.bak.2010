  {
   "id": 3496,
   "offset": 4060203,
   "text": "간끔빨랙뚜그\n눗같례맍",
   "unknown": 0,
   "hangul": 10
  },
  {
   "id": 3497,
   "offset": 4060225,
   "text": "교랻킬□처같\n나벤□렉□롤",
   "unknown": 3,
   "hangul": 9
  },
  {
   "id": 3498,
   "offset": 4060251,
   "text": "랻책간깨겹관낚헉픕몬\n끔겉군과낡꽁끓",
   "unknown": 0,
   "hangul": 17
  },
  {
   "id": 3499,
   "offset": 4060287,
   "text": "겉공례띠몬캔\n간나화륜끗?",
   "unknown": 0,
   "hangul": 11
  },
  {
   "id": 3500,
   "offset": 4060312,
   "text": "교놔덤같닙룹\n개길렉꽁",
   "unknown": 0,
   "hangul": 10
  },
  {
   "id": 3501,
   "offset": 4060334,
   "text": "딥공깊똑룸체덤!\n간룹넘밑갤끗?",
   "unknown": 0,
   "hangul": 13
  },
  {
   "id": 3502,
   "offset": 4060364,
   "text": "다당밀밈",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3503,
   "offset": 4060373,
   "text": "이요네-",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3504,
   "offset": 4060378,
   "text": "히미츠키치란테이이요네!\n나등카와쿠와쿠시테코나이?",
   "unknown": 0,
   "hangul": 23
  },
  {
   "id": 3505,
   "offset": 4060409,
   "text": "의퀸센크낫-일",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 3506,
   "offset": 4060418,
   "text": "다당문개",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3507,
   "offset": 4060427,
   "text": "헌다당풀끗?",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3508,
   "offset": 4060439,
   "text": "게멀",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3509,
   "offset": 4060444,
   "text": "밴심",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3510,
   "offset": 4060449,
   "text": "건□",
   "unknown": 1,
   "hangul": 1
  },
  {
   "id": 3511,
   "offset": 4060454,
   "text": "빰갗",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3512,
   "offset": 4060459,
   "text": "밉넬",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3513,
   "offset": 4060464,
   "text": "넋넬끓!",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3514,
   "offset": 4060472,
   "text": "낚헉꼬던학!",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3515,
   "offset": 4060484,
   "text": "간끔룩획끓…",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3516,
   "offset": 4060496,
   "text": "모우코레이도즈우타투나이미타이…",
   "unknown": 0,
   "hangul": 15
  },
  {
   "id": 3517,
   "offset": 4060516,
   "text": "□뷔몬뽀협뜨뜨끓\n□교함갔□저\n겨참넣\n『캬럴□눈1늑개객』",
   "unknown": 4,
   "hangul": 20
  },
  {
   "id": 3518,
   "offset": 4060571,
   "text": "『1후등호푸카카리마스』",
   "unknown": 0,
   "hangul": 9
  },
  {
   "id": 3519,
   "offset": 4060585,
   "text": "게곧벤□간끔뽀협\n꽥끔미믄뚠문\n『겨쁨A감』",
   "unknown": 1,
   "hangul": 16
  },
  {
   "id": 3520,
   "offset": 4060625,
   "text": "이『간끔미믄함갔본굶\n힐화꼬□』",
   "unknown": 1,
   "hangul": 12
  },
  {
   "id": 3521,
   "offset": 4060656,
   "text": "□저렁렇끓!\n룩과뽀협□뷔\n겨참넣",
   "unknown": 2,
   "hangul": 12
  },
  {
   "id": 3522,
   "offset": 4060688,
   "text": "□뷔뽀협렁렇끓\n이『간끔미믄함갔본굶\n힐화꼬□』",
   "unknown": 2,
   "hangul": 18
  },
  {
   "id": 3523,
   "offset": 4060734,
   "text": "몬의-안트카키코미마스\n시페라쿠오마치쿠베사이",
   "unknown": 0,
   "hangul": 21
  },
  {
   "id": 3524,
   "offset": 4060759,
   "text": "몬의-안노카키코미하시지우리즈우시마시타\n이『코노마마있우케등트츠파케루코토하피키마세등\n밧는안혼니모푸리마스』",
   "unknown": 0,
   "hangul": 51
  },
  {
   "id": 3525,
   "offset": 4060823,
   "text": "□뷔뽀협\n렁렇끓\n『겨쁨A감』",
   "unknown": 1,
   "hangul": 9
  },
  {
   "id": 3526,
   "offset": 4060849,
   "text": "밀햅□",
   "unknown": 1,
   "hangul": 2
  },
  {
   "id": 3527,
   "offset": 4060856,
   "text": "체덤",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3529,
   "offset": 4060865,
   "text": "쿠세등",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3530,
   "offset": 4060869,
   "text": "히미츠키치",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3531,
   "offset": 4060875,
   "text": "쿤덴안",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3532,
   "offset": 4060879,
   "text": "너의이름은?",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3534,
   "offset": 4060891,
   "text": "려낀몬문끝?",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3535,
   "offset": 4060904,
   "text": "의닉네임은?",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3536,
   "offset": 4060916,
   "text": "라이벌의이름은?",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 3538,
   "offset": 4061202,
   "text": "드닌갓거릿온넨준힌솔록래석달잔단통렛들",
   "unknown": 0,
   "hangul": 19
  },
  {
   "id": 3539,
   "offset": 4061222,
   "text": "술복양버굴주×。,…『』「」/ㅎ우",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 3541,
   "offset": 4061244,
   "text": "발",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 3542,
   "offset": 4061250,
   "text": "런",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 3543,
   "offset": 4061256,
   "text": "뒤로",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3544,
   "offset": 4061262,
   "text": "곁",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 3545,
   "offset": 4061267,
   "text": "에",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 3546,
   "offset": 4061269,
   "text": "겁것",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3547,
   "offset": 4061276,
   "text": "이동",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3548,
   "offset": 4061282,
   "text": "갱",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 3549,
   "offset": 4061287,
   "text": "쿠",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 3550,
   "offset": 4061289,
   "text": "섭□",
   "unknown": 1,
   "hangul": 1
  },
  {
   "id": 3551,
   "offset": 4061295,
   "text": "겹듀픈많존\n희눔몬수된。\n관콘례딛몬버태\n버놓몬갯꿈꾸。",
   "unknown": 0,
   "hangul": 23
  },
  {
   "id": 3552,
   "offset": 4061347,
   "text": "니나루히토모오오이。",
   "unknown": 0,
   "hangul": 9
  },
  {
   "id": 3553,
   "offset": 4061360,
   "text": "빠솜촉꾸\n□게문몬승똑궈。\n역교뼘꿈몬촉촉첵분\n놔꾐꼭□딧。",
   "unknown": 2,
   "hangul": 23
  },
  {
   "id": 3554,
   "offset": 4061416,
   "text": "이시토요페레테이루。",
   "unknown": 0,
   "hangul": 9
  },
  {
   "id": 3555,
   "offset": 4061429,
   "text": "관권꺽덤콤땐몬\n꽥빠꼭끔육둑2회궂11회겹놓\n느걷괘관꿈깊문몬。",
   "unknown": 0,
   "hangul": 26
  },
  {
   "id": 3556,
   "offset": 4061488,
   "text": "토피유우메이。",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 3557,
   "offset": 4061497,
   "text": "23회겹놓같몬궐처。\n관뭐뭔댑대댕\n딴딸꺼둔몬덤덥\n느걷뒈게문。",
   "unknown": 0,
   "hangul": 25
  },
  {
   "id": 3558,
   "offset": 4061555,
   "text": "페레루요우니나란타。",
   "unknown": 0,
   "hangul": 9
  },
  {
   "id": 3559,
   "offset": 4061567,
   "text": "떾된버같몬천택。\n빠꼭멱꿋\n깊문몬다당꾹꾼\n꼴륜꼬깨겹。",
   "unknown": 0,
   "hangul": 23
  },
  {
   "id": 3560,
   "offset": 4061619,
   "text": "나피요페레루요우니나란타。",
   "unknown": 0,
   "hangul": 12
  },
  {
   "id": 3561,
   "offset": 4061635,
   "text": "교□듀픈\n끔떨곧꿈꾸몬다당\n눈관나능공다당몬겊。\n깠환꿈꽁。",
   "unknown": 1,
   "hangul": 24
  },
  {
   "id": 3562,
   "offset": 4061691,
   "text": "리제베이니등키。",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 3563,
   "offset": 4061701,
   "text": "례딛몬덤갚며겹。\n꿈력깊갯둑둔\n며겹환든꿈몸\n□눈깊딤뒈끔둑둔。",
   "unknown": 1,
   "hangul": 26
  },
  {
   "id": 3564,
   "offset": 4061761,
   "text": "히츠요우。",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3565,
   "offset": 4061767,
   "text": "관육밟20회놈겹몬\n2콘□□\n빠꼭□녀냅괃\n며꾐꼭낀□。",
   "unknown": 4,
   "hangul": 17
  },
  {
   "id": 3566,
   "offset": 4061817,
   "text": "후타두도마토요페레테이루。",
   "unknown": 0,
   "hangul": 12
  },
  {
   "id": 3567,
   "offset": 4061833,
   "text": "깊꿈꾸\n다당슬궤몬몬□□。\n렴례\n꿈꾸갯공뼘넉연。",
   "unknown": 2,
   "hangul": 18
  },
  {
   "id": 3568,
   "offset": 4061879,
   "text": "우노타메니오토바레테이루。",
   "unknown": 0,
   "hangul": 12
  },
  {
   "id": 3569,
   "offset": 4061895,
   "text": "깊꿈꾸더덕몬다당\n교뼘겉뺨\n다당밀밈□벴몬\n똑룸궐처",
   "unknown": 1,
   "hangul": 22
  },
  {
   "id": 3570,
   "offset": 4061945,
   "text": "테이루\n나부노푸우쿠츠",
   "unknown": 0,
   "hangul": 10
  },
  {
   "id": 3571,
   "offset": 4061958,
   "text": "궈탠문몬떨둘탱。\n뚱천겜꾸맵…\n꿀문군□늑벌범괘끔걸검\n환든멱꿋둘다당。",
   "unknown": 1,
   "hangul": 29
  },
  {
   "id": 3573,
   "offset": 4062027,
   "text": "뚱꺼뻐볶쌓떨몬딤궈\n…꽥□□\n딤으견템꿉즙논꽈\n른캬건끔쌓떨。",
   "unknown": 2,
   "hangul": 24
  },
  {
   "id": 3574,
   "offset": 4062085,
   "text": "토트타타나이。",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 3575,
   "offset": 4062094,
   "text": "□3□같몬군□\n깊꿈꾸록몬수된。\n넘공록꿈깊검\n군것눈궁。",
   "unknown": 3,
   "hangul": 20
  },
  {
   "id": 3576,
   "offset": 4062147,
   "text": "나등푸모오토바레타쿠나루。",
   "unknown": 0,
   "hangul": 12
  },
  {
   "id": 3577,
   "offset": 4062163,
   "text": "4□같\n서켓몬궐처。\n딥강궐처몬몹환든\n끔함띨꼴랻。",
   "unknown": 1,
   "hangul": 19
  },
  {
   "id": 3578,
   "offset": 4062210,
   "text": "미니츠나제란테이루라시이。",
   "unknown": 0,
   "hangul": 12
  },
  {
   "id": 3579,
   "offset": 4062226,
   "text": "껌체딧승똑덤\n끔닐갯버뜨몬승딨궐궤。\n딥강꿈꾸갯\n교뼘뜨흠。",
   "unknown": 0,
   "hangul": 25
  },
  {
   "id": 3580,
   "offset": 4062282,
   "text": "후메이니나루히토모이루。",
   "unknown": 0,
   "hangul": 11
  },
  {
   "id": 3581,
   "offset": 4062297,
   "text": "푥강뼘꿈쿼멱꿋승딨다당몬\n모□□□。\n건관…\n던깊갯몸둔다당。",
   "unknown": 3,
   "hangul": 22
  },
  {
   "id": 3582,
   "offset": 4062355,
   "text": "모노하이나이。",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 3583,
   "offset": 4062364,
   "text": "둔궁군□꼬라깠콘문끝\n꽥관꼭낚헉\n라깠콘문끝\n던깊갯깨겹。",
   "unknown": 1,
   "hangul": 24
  },
  {
   "id": 3584,
   "offset": 4062419,
   "text": "모우소등데이시나이。",
   "unknown": 0,
   "hangul": 9
  },
  {
   "id": 3585,
   "offset": 4062431,
   "text": "댁멀몬려된。\n깊몬덤덥간껴놔\n깐꽁낸깊낚헉똑룸\n깊갯곽뼘교함갔끊끌。",
   "unknown": 0,
   "hangul": 29
  },
  {
   "id": 3587,
   "offset": 4062497,
   "text": "떨곧끓슬덤포턱몬\n모□□□。\n빠꼭뱀같깊6콘궐\n며놔꾐꼭례궤。",
   "unknown": 3,
   "hangul": 22
  },
  {
   "id": 3588,
   "offset": 4062554,
   "text": "사레타。",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3589,
   "offset": 4062559,
   "text": "몬보섬\n둑둥경곁끔곳공",
   "unknown": 0,
   "hangul": 10
  },
  {
   "id": 3590,
   "offset": 4062585,
   "text": "타",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 3591,
   "offset": 4062587,
   "text": "보섬\n둑둥경곁끔곳공",
   "unknown": 0,
   "hangul": 9
  },
  {
   "id": 3592,
   "offset": 4062610,
   "text": "란타",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3593,
   "offset": 4062613,
   "text": "몬보섬캬\n끔맙옷몬곳공",
   "unknown": 0,
   "hangul": 10
  },
  {
   "id": 3594,
   "offset": 4062642,
   "text": "시타",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3595,
   "offset": 4062645,
   "text": "보섬캬\n끔맙옷몬곳공",
   "unknown": 0,
   "hangul": 9
  },
  {
   "id": 3596,
   "offset": 4062672,
   "text": "시타",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3597,
   "offset": 4062676,
   "text": "한성격때\n에서만남",
   "unknown": 0,
   "hangul": 8
  },
  {
   "id": 3598,
   "offset": 4062701,
   "text": "한성격때\n에서만남",
   "unknown": 0,
   "hangul": 8
  },
  {
   "id": 3599,
   "offset": 4062725,
   "text": "몬보섬캬\n곳공",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 3600,
   "offset": 4062749,
   "text": "요우베",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3601,
   "offset": 4062753,
   "text": "보섬캬\n곳공",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3602,
   "offset": 4062775,
   "text": "타요우베",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3603,
   "offset": 4062780,
   "text": "몬보섬캬\n경곁끓",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 3604,
   "offset": 4062805,
   "text": "보섬캬\n경곁끓",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 3605,
   "offset": 4062829,
   "text": "몬보섬캬\n경곁끓",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 3606,
   "offset": 4062855,
   "text": "보섬캬\n경곁끓",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 3607,
   "offset": 4062879,
   "text": "란타요우베",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3608,
   "offset": 4062886,
   "text": "몬보섬캬\n경곁\n끔맙옷몬곳공",
   "unknown": 0,
   "hangul": 12
  },
  {
   "id": 3609,
   "offset": 4062923,
   "text": "시타",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3610,
   "offset": 4062927,
   "text": "보섬캬\n경곁\n끔맙옷몬곳공",
   "unknown": 0,
   "hangul": 11
  },
  {
   "id": 3611,
   "offset": 4062962,
   "text": "트시타",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3612,
   "offset": 4062967,
   "text": "몬보섬캬\n경곁\n끔맙옷몬곳공",
   "unknown": 0,
   "hangul": 12
  },
  {
   "id": 3613,
   "offset": 4063004,
   "text": "시타요우베",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3614,
   "offset": 4063011,
   "text": "보섬캬\n경곁\n끔맙옷몬곳공",
   "unknown": 0,
   "hangul": 11
  },
  {
   "id": 3615,
   "offset": 4063046,
   "text": "트시타요우베",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 3616,
   "offset": 4063054,
   "text": "고턴성귤넘공몬\n딨년다당□",
   "unknown": 1,
   "hangul": 11
  },
  {
   "id": 3617,
   "offset": 4063080,
   "text": "노밧롯탄",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3618,
   "offset": 4063085,
   "text": "고땍땍깐환넘공몬\n딨년다당□",
   "unknown": 1,
   "hangul": 12
  },
  {
   "id": 3619,
   "offset": 4063113,
   "text": "롯탄",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3620,
   "offset": 4063116,
   "text": "고게멀몬댕느넘공몬\n딨년다당□",
   "unknown": 1,
   "hangul": 13
  },
  {
   "id": 3621,
   "offset": 4063146,
   "text": "노밧롯탄",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3622,
   "offset": 4063151,
   "text": "고□먈빈□□깐넘공몬\n딨년다당□",
   "unknown": 4,
   "hangul": 11
  },
  {
   "id": 3623,
   "offset": 4063183,
   "text": "검둑둥경곁\n넘공몬딨년다당□",
   "unknown": 1,
   "hangul": 12
  },
  {
   "id": 3624,
   "offset": 4063211,
   "text": "탄",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 3625,
   "offset": 4063213,
   "text": "다당□게꺽□눈캬럴…",
   "unknown": 2,
   "hangul": 7
  },
  {
   "id": 3626,
   "offset": 4063233,
   "text": "나리\n카카리소우베…",
   "unknown": 0,
   "hangul": 8
  },
  {
   "id": 3627,
   "offset": 4063244,
   "text": "꺽게끓낚헉?\n공게꺽괘□눈캬럴。",
   "unknown": 1,
   "hangul": 12
  },
  {
   "id": 3628,
   "offset": 4063274,
   "text": "소우",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3629,
   "offset": 4063277,
   "text": "꺼녈높군높\n꽁낸게꺽몬끔뎌군□?",
   "unknown": 1,
   "hangul": 13
  },
  {
   "id": 3631,
   "offset": 4063310,
   "text": "딥공끓딤땀\n핵같눈게꺽끓!",
   "unknown": 0,
   "hangul": 11
  },
  {
   "id": 3632,
   "offset": 4063335,
   "text": "우베!",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3633,
   "offset": 4063339,
   "text": "둑둥경곁",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3634,
   "offset": 4063348,
   "text": "덜?",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 3635,
   "offset": 4063352,
   "text": "포켓몬정보",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3636,
   "offset": 4063362,
   "text": "포켓몬능력",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3637,
   "offset": 4063372,
   "text": "믹힌기술",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3638,
   "offset": 4063381,
   "text": "섭□",
   "unknown": 1,
   "hangul": 1
  },
  {
   "id": 3639,
   "offset": 4063387,
   "text": "□재의경험치",
   "unknown": 1,
   "hangul": 5
  },
  {
   "id": 3640,
   "offset": 4063398,
   "text": "다음레벨까지",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 3641,
   "offset": 4063409,
   "text": "전환취소",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3642,
   "offset": 4063421,
   "text": "겔겜",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3643,
   "offset": 4063432,
   "text": "전환",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3644,
   "offset": 4063439,
   "text": "전환자세하게",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 3645,
   "offset": 4063452,
   "text": "선택바꾸기",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3646,
   "offset": 4063465,
   "text": "갱횟",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3647,
   "offset": 4063472,
   "text": "갱횟□□",
   "unknown": 2,
   "hangul": 2
  },
  {
   "id": 3648,
   "offset": 4063485,
   "text": "깐콘관맨□몬욱끔\n간끔□□!",
   "unknown": 3,
   "hangul": 9
  },
  {
   "id": 3649,
   "offset": 4063512,
   "text": "주인",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3651,
   "offset": 4063522,
   "text": "돈",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 3652,
   "offset": 4063525,
   "text": "카이",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3653,
   "offset": 4063528,
   "text": "엔",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 3654,
   "offset": 4063530,
   "text": "포켓몬도감",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3655,
   "offset": 4063538,
   "text": "마리",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3658,
   "offset": 4063546,
   "text": "한시간",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3659,
   "offset": 4063551,
   "text": "짠늑",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3660,
   "offset": 4063556,
   "text": "의는크안",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3661,
   "offset": 4063561,
   "text": "댑대댕밋",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3662,
   "offset": 4063571,
   "text": "게과몬푥황",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3664,
   "offset": 4063584,
   "text": "둑둥곽넌",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3665,
   "offset": 4063593,
   "text": "딱휜곽넌",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3666,
   "offset": 4063602,
   "text": "냠너대",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3667,
   "offset": 4063612,
   "text": "다당둑둥경곁",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 3668,
   "offset": 4063625,
   "text": "밀밈곽넌경곁",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 3669,
   "offset": 4063639,
   "text": "록뚝슴범",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3670,
   "offset": 4063648,
   "text": "넣핍곽낙참□밋분",
   "unknown": 1,
   "hangul": 7
  },
  {
   "id": 3671,
   "offset": 4063665,
   "text": "마란테이마스",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 3672,
   "offset": 4063672,
   "text": "설정변경",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3673,
   "offset": 4063682,
   "text": "텍스트속도",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3674,
   "offset": 4063691,
   "text": "전투화면",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3675,
   "offset": 4063700,
   "text": "시합롤",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3676,
   "offset": 4063709,
   "text": "사운드",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3677,
   "offset": 4063714,
   "text": "버튼모드",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3678,
   "offset": 4063721,
   "text": "윈도우",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3679,
   "offset": 4063727,
   "text": "닫기",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3680,
   "offset": 4063731,
   "text": "느리",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3681,
   "offset": 4063735,
   "text": "보통",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3682,
   "offset": 4063739,
   "text": "빠르",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3683,
   "offset": 4063743,
   "text": "보다",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3684,
   "offset": 4063746,
   "text": "안봄",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3685,
   "offset": 4063751,
   "text": "교체",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3686,
   "offset": 4063756,
   "text": "계속",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3687,
   "offset": 4063761,
   "text": "모노",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3688,
   "offset": 4063766,
   "text": "스테레오",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3689,
   "offset": 4063771,
   "text": "걷프",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3690,
   "offset": 4063775,
   "text": "헬프",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3691,
   "offset": 4063779,
   "text": "한손",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3693,
   "offset": 4063786,
   "text": "타입",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3694,
   "offset": 4063791,
   "text": "갱학곁렁렇",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3695,
   "offset": 4063812,
   "text": "문□RTC\nA감겁것B감겟게",
   "unknown": 1,
   "hangul": 7
  },
  {
   "id": 3696,
   "offset": 4063836,
   "text": "섭곧교뚠문캬럴",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 3697,
   "offset": 4063851,
   "text": "섭낮과뚠문캬럴",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 3698,
   "offset": 4063866,
   "text": "계봉것캬럴",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3699,
   "offset": 4063877,
   "text": "계봉것캬럴끓!\n교땟럽□뷔겨참넣",
   "unknown": 1,
   "hangul": 13
  },
  {
   "id": 3700,
   "offset": 4063909,
   "text": "□뷔뽀협끓!",
   "unknown": 1,
   "hangul": 4
  },
  {
   "id": 3701,
   "offset": 4063921,
   "text": "□뷔몬뽀협\n뜨뜨끓…",
   "unknown": 1,
   "hangul": 7
  },
  {
   "id": 3702,
   "offset": 4063940,
   "text": "던깊□뷔\n간끔함갔캬럴몬봉것!",
   "unknown": 1,
   "hangul": 12
  },
  {
   "id": 3703,
   "offset": 4063969,
   "text": "간검뚠문캬럴몬쎈몹\n끔걸검끓!",
   "unknown": 0,
   "hangul": 13
  },
  {
   "id": 3704,
   "offset": 4063999,
   "text": "면-쥬나이도카등노시지우세이픽콘냐쥬제\n츠카에루요우니나리마시타!",
   "unknown": 0,
   "hangul": 30
  },
  {
   "id": 3705,
   "offset": 4064038,
   "text": "□교뽀협다당□뷔\n겨간눈를꺄둘콷",
   "unknown": 2,
   "hangul": 13
  },
  {
   "id": 3706,
   "offset": 4064070,
   "text": "베사이",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3707,
   "offset": 4064074,
   "text": "포켓몬과만나거나잡았을경우\n포켓몬의비밀이기록되는도구",
   "unknown": 0,
   "hangul": 26
  },
  {
   "id": 3708,
   "offset": 4064118,
   "text": "함께모험할때\n포켓몬의정보를자세하게알수있다",
   "unknown": 0,
   "hangul": 21
  },
  {
   "id": 3709,
   "offset": 4064160,
   "text": "이겨서받거나발견해서\n도구를넣는주꼬니가방",
   "unknown": 0,
   "hangul": 20
  },
  {
   "id": 3710,
   "offset": 4064201,
   "text": "지금당신이가지고있는뱃지나\n플레이정보를알수있다",
   "unknown": 0,
   "hangul": 23
  },
  {
   "id": 3711,
   "offset": 4064243,
   "text": "잠깐쉬고싶다면이레포트로\n□재의모든상태를기록",
   "unknown": 1,
   "hangul": 21
  },
  {
   "id": 3712,
   "offset": 4064287,
   "text": "말의빠르기나시합의롤을\n바꾸거나여러가지설정이가능",
   "unknown": 0,
   "hangul": 24
  },
  {
   "id": 3713,
   "offset": 4064329,
   "text": "이메뉴를닫는다",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 3714,
   "offset": 4064342,
   "text": "맷꼬맹먹렁렇\n화공낮릍",
   "unknown": 0,
   "hangul": 10
  },
  {
   "id": 3715,
   "offset": 4064364,
   "text": "니모푸루",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3716,
   "offset": 4064370,
   "text": "곧교몬점깝",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3717,
   "offset": 4064382,
   "text": "{var:01}다당\n궂{var:02}{var:03}\n경곁끓!",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 3718,
   "offset": 4064406,
   "text": "뽀협끓{var:02}몬{var:03}\n{var:04}\n닿꿋끓!",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 3719,
   "offset": 4064431,
   "text": "리토모타세타!",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 3720,
   "offset": 4064440,
   "text": "{var:02}깐환뽀협끓{var:03}",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3721,
   "offset": 4064456,
   "text": "깠환\n겹겼{var:02}\n헌{var:03}걸검!",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 3722,
   "offset": 4064479,
   "text": "타!",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 3723,
   "offset": 4064482,
   "text": "{var:01}걸검끓{var:02}!",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3724,
   "offset": 4064496,
   "text": "맨긍득□몬\n{var:02}걸검끓!!",
   "unknown": 1,
   "hangul": 7
  },
  {
   "id": 3726,
   "offset": 4064520,
   "text": "{var:02}검똑□\n껴넓끓{var:03}!",
   "unknown": 1,
   "hangul": 5
  },
  {
   "id": 3727,
   "offset": 4064541,
   "text": "{var:02}검똑□\n껴넓끓{var:03}\n□□끓{var:04}!",
   "unknown": 3,
   "hangul": 6
  },
  {
   "id": 3728,
   "offset": 4064570,
   "text": "교다당문개\n닐다당할림끓!",
   "unknown": 0,
   "hangul": 11
  },
  {
   "id": 3729,
   "offset": 4064595,
   "text": "널꾼\n함갔끓꺾훨몬\n다당꺅포!",
   "unknown": 0,
   "hangul": 12
  },
  {
   "id": 3730,
   "offset": 4064628,
   "text": "티트시타!",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3731,
   "offset": 4064634,
   "text": "몹미\n간갔\n검칼텍!",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 3732,
   "offset": 4064662,
   "text": "세등시타!",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3733,
   "offset": 4064668,
   "text": "림냈뜻넌\n렁록\n꺅포냠너끓!",
   "unknown": 0,
   "hangul": 11
  },
  {
   "id": 3734,
   "offset": 4064697,
   "text": "카란타!",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3735,
   "offset": 4064703,
   "text": "친□몬겹겼득□\n{var:02}뽀협교둘둠환!",
   "unknown": 2,
   "hangul": 11
  },
  {
   "id": 3736,
   "offset": 4064734,
   "text": "{var:01}고둘둠문\n겹겼□게끓{var:02}!",
   "unknown": 1,
   "hangul": 8
  },
  {
   "id": 3737,
   "offset": 4064760,
   "text": "검{var:02}몬{var:03}\n경곁{var:04}",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3738,
   "offset": 4064776,
   "text": "시타",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3739,
   "offset": 4064779,
   "text": "겸갯꺅싶\n궂꺅포끓!\n꿈꽁몬꺅싶",
   "unknown": 0,
   "hangul": 13
  },
  {
   "id": 3740,
   "offset": 4064814,
   "text": "아",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 3741,
   "offset": 4064816,
   "text": "잊갯꺅싶\n꺅포끓!\n몹빅몬렁록",
   "unknown": 0,
   "hangul": 12
  },
  {
   "id": 3743,
   "offset": 4064853,
   "text": "꾸갯꺅싶궂\n궂꺅포!\n꿈밑박몬꺅포",
   "unknown": 0,
   "hangul": 14
  },
  {
   "id": 3744,
   "offset": 4064899,
   "text": "냠끓",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3745,
   "offset": 4064904,
   "text": "대끓",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3746,
   "offset": 4064909,
   "text": "궂꿈꾸갯\n교밀밈처곳!",
   "unknown": 0,
   "hangul": 9
  },
  {
   "id": 3747,
   "offset": 4064930,
   "text": "피아란타!",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3748,
   "offset": 4064936,
   "text": "{var:02}교{var:03}\n포미\n미믄낮함!",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 3749,
   "offset": 4064959,
   "text": "니무카란타!",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3750,
   "offset": 4064967,
   "text": "몬\n몬\n경곁끓!",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3751,
   "offset": 4064991,
   "text": "이레카에타!",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3752,
   "offset": 4064999,
   "text": "몬\n갠갤공끓!",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3753,
   "offset": 4065018,
   "text": "니\n요쿠카등제에테이푸우시타!",
   "unknown": 0,
   "hangul": 13
  },
  {
   "id": 3754,
   "offset": 4065036,
   "text": "몬\n궂경곁끓!",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3755,
   "offset": 4065055,
   "text": "몬\n갠갤끓!",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3756,
   "offset": 4065070,
   "text": "몬\n궂경곁끓!",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3757,
   "offset": 4065089,
   "text": "카에타!",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3758,
   "offset": 4065094,
   "text": "몬\n닿꿋끓!",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3759,
   "offset": 4065109,
   "text": "에타!",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3760,
   "offset": 4065113,
   "text": "낙같몬\n갠갤공!",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 3761,
   "offset": 4065133,
   "text": "몬다당\n군논갠갤공\n!",
   "unknown": 0,
   "hangul": 8
  },
  {
   "id": 3762,
   "offset": 4065157,
   "text": "우시타!",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3763,
   "offset": 4065162,
   "text": "댕슴",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3764,
   "offset": 4065167,
   "text": "즈",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 3765,
   "offset": 4065169,
   "text": "고{var:01}몬둘둠\n□게{var:02}\n헌끓{var:03}!",
   "unknown": 1,
   "hangul": 7
  },
  {
   "id": 3766,
   "offset": 4065195,
   "text": "자등토모타세타!",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 3767,
   "offset": 4065205,
   "text": "고둘둠문{var:02}\n닐{var:03}닿꿋\n{var:04}겔띨친□!",
   "unknown": 1,
   "hangul": 10
  },
  {
   "id": 3768,
   "offset": 4065238,
   "text": "시마란타!",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3769,
   "offset": 4065245,
   "text": "궂꿈꾸갯\n강겊!",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 3770,
   "offset": 4065260,
   "text": "시자투리시타!",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 3771,
   "offset": 4065268,
   "text": "군개",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3772,
   "offset": 4065273,
   "text": "넋뼈",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3773,
   "offset": 4065279,
   "text": "간갔",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3774,
   "offset": 4065284,
   "text": "곳공{var:02}몬\n{var:03}궂{var:04}\n경곁끓!",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 3775,
   "offset": 4065309,
   "text": "곳공{var:02}\n함갔끓다당꺅포\n곽넌렁록{var:03}",
   "unknown": 0,
   "hangul": 13
  },
  {
   "id": 3776,
   "offset": 4065343,
   "text": "되된독될됨\n뿌끓!\n꿈껌빵끼!",
   "unknown": 0,
   "hangul": 11
  },
  {
   "id": 3777,
   "offset": 4065374,
   "text": "타노시등베!",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3778,
   "offset": 4065381,
   "text": "되된독될됨\n뿌끓!\n□끓엔!",
   "unknown": 1,
   "hangul": 9
  },
  {
   "id": 3779,
   "offset": 4065411,
   "text": "엔츠카란타!",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3780,
   "offset": 4065421,
   "text": "교몬\n되된독될됨\n쓰끓!",
   "unknown": 0,
   "hangul": 9
  },
  {
   "id": 3781,
   "offset": 4065453,
   "text": "되된독될됨\n쓰끓!\n넘공끓엔!!",
   "unknown": 0,
   "hangul": 11
  },
  {
   "id": 3782,
   "offset": 4065487,
   "text": "후에타!!",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3783,
   "offset": 4065493,
   "text": "1콘",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 3785,
   "offset": 4065502,
   "text": "{var:02}검욱끔꺽□\n냇냈할림끓!",
   "unknown": 1,
   "hangul": 9
  },
  {
   "id": 3786,
   "offset": 4065528,
   "text": "{var:02}검욱끔□록\n냇냈할림끓!",
   "unknown": 1,
   "hangul": 9
  },
  {
   "id": 3787,
   "offset": 4065554,
   "text": "{var:02}검똑푥욱\n껴넓끓{var:03}!",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 3788,
   "offset": 4065576,
   "text": "있에타!",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3789,
   "offset": 4065581,
   "text": "{var:02}검똑푥욱\n껴넓끓{var:03}!",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 3790,
   "offset": 4065603,
   "text": "□□끓{var:04}!",
   "unknown": 2,
   "hangul": 1
  },
  {
   "id": 3791,
   "offset": 4065613,
   "text": "타!",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 3792,
   "offset": 4065616,
   "text": "검\n다당\n밥끓!",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3793,
   "offset": 4065637,
   "text": "타오시타!",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3794,
   "offset": 4065644,
   "text": "\n\n햇꼬밥끓!",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3795,
   "offset": 4065662,
   "text": "히키타오시타!",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 3796,
   "offset": 4065673,
   "text": "검\n다당\n능공끓!",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 3797,
   "offset": 4065696,
   "text": "츠카마에타!",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3798,
   "offset": 4065703,
   "text": "검\n햇\n능공끓!",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3799,
   "offset": 4065725,
   "text": "나디마쿠란테츠카마에타!",
   "unknown": 0,
   "hangul": 11
  },
  {
   "id": 3800,
   "offset": 4065740,
   "text": "걸검\n겪뜨\n능공끓!",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 3801,
   "offset": 4065767,
   "text": "검\n겪뜨\n능공끓햇!",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 3802,
   "offset": 4065794,
   "text": "타!",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 3803,
   "offset": 4065797,
   "text": "검\n겪뜨끓햇\n능공끓!",
   "unknown": 0,
   "hangul": 8
  },
  {
   "id": 3804,
   "offset": 4065828,
   "text": "타!",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 3805,
   "offset": 4065831,
   "text": "검\n겪뜨햇\n능공끓햇!",
   "unknown": 0,
   "hangul": 8
  },
  {
   "id": 3806,
   "offset": 4065863,
   "text": "츠카마에타!",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3807,
   "offset": 4065871,
   "text": "{var:02}닐{var:03}\n넘공끓!",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3808,
   "offset": 4065887,
   "text": "세타!",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3809,
   "offset": 4065891,
   "text": "{var:01}닐{var:02}\n늘{var:03}\n넘공끓!",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3810,
   "offset": 4065912,
   "text": "타!",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 3811,
   "offset": 4065915,
   "text": "{var:02}똑푥욱\n럴슴럼걸검끓!",
   "unknown": 0,
   "hangul": 9
  },
  {
   "id": 3812,
   "offset": 4065938,
   "text": "{var:02}똑푥욱\n걸검끓눗맍멘\n눗공끓{var:03}!",
   "unknown": 0,
   "hangul": 12
  },
  {
   "id": 3813,
   "offset": 4065971,
   "text": "{var:02}똑푥욱\n걸검끓□□멘\n텐교놈같!",
   "unknown": 2,
   "hangul": 11
  },
  {
   "id": 3814,
   "offset": 4066003,
   "text": "{var:02}\n똑푥욱\n걸검끓다냈멘!!",
   "unknown": 0,
   "hangul": 9
  },
  {
   "id": 3816,
   "offset": 4066030,
   "text": "{var:02}걸검\n똑푥욱놈묶멘\n□여많존!",
   "unknown": 1,
   "hangul": 11
  },
  {
   "id": 3817,
   "offset": 4066061,
   "text": "테라시타!",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3818,
   "offset": 4066068,
   "text": "교깠환{var:02}\n걸검끓똑푥욱\n첵숙멘!",
   "unknown": 0,
   "hangul": 12
  },
  {
   "id": 3819,
   "offset": 4066099,
   "text": "{var:02}\n걸검끓똑푥욱\n엉□멘!",
   "unknown": 1,
   "hangul": 8
  },
  {
   "id": 3820,
   "offset": 4066123,
   "text": "{var:02}꼭끓공놈책\n걸검끓똑푥욱\n□놈멘!",
   "unknown": 1,
   "hangul": 13
  },
  {
   "id": 3821,
   "offset": 4066157,
   "text": "와데\n얀는핫크일트츠카란타!",
   "unknown": 0,
   "hangul": 12
  },
  {
   "id": 3822,
   "offset": 4066173,
   "text": "{var:02}걸검□궤\n고{var:03}\n□보끓!",
   "unknown": 2,
   "hangul": 6
  },
  {
   "id": 3823,
   "offset": 4066197,
   "text": "츠시타!",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3824,
   "offset": 4066202,
   "text": "{var:02}걸검짖□\n짧□다당!",
   "unknown": 2,
   "hangul": 6
  },
  {
   "id": 3825,
   "offset": 4066223,
   "text": "트사소이베시타!",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 3826,
   "offset": 4066233,
   "text": "{var:02}걸검셋낱!\n곽{var:03}몬{var:04}\n셋낱끓!",
   "unknown": 0,
   "hangul": 9
  },
  {
   "id": 3827,
   "offset": 4066262,
   "text": "안시타!",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3828,
   "offset": 4066267,
   "text": "{var:01}보견{var:02}몬\n{var:03}\n미믄낮함!",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 3829,
   "offset": 4066292,
   "text": "교{var:02}몬\n딤따,뚠문텔\n꽁꽁몬곤!",
   "unknown": 0,
   "hangul": 11
  },
  {
   "id": 3830,
   "offset": 4066322,
   "text": "{var:01}교멜먼륜문\n꽁꽁몬몇눔!",
   "unknown": 0,
   "hangul": 10
  },
  {
   "id": 3831,
   "offset": 4066347,
   "text": "{var:01}\n보견꽝꽤꾹꾼몬\n끊끌느!",
   "unknown": 0,
   "hangul": 10
  },
  {
   "id": 3832,
   "offset": 4066374,
   "text": "{var:02}땟갔댕\n꽁꽁눈짐……\n넉넋넌널!",
   "unknown": 0,
   "hangul": 11
  },
  {
   "id": 3833,
   "offset": 4066404,
   "text": "니피타!",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3834,
   "offset": 4066409,
   "text": "{var:02}땟갔댕\n밖넌!",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3835,
   "offset": 4066424,
   "text": "{var:01}\n교맷꼬맹먹\n능다당!",
   "unknown": 0,
   "hangul": 8
  },
  {
   "id": 3836,
   "offset": 4066446,
   "text": "우베란타!",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3837,
   "offset": 4066452,
   "text": "보견{var:03}\n빅뻥건걷댐끓!",
   "unknown": 0,
   "hangul": 8
  },
  {
   "id": 3838,
   "offset": 4066473,
   "text": "키타!",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3839,
   "offset": 4066477,
   "text": "교몬땟갔댕궂꺅포\n곽검\n꺅포냠너!",
   "unknown": 0,
   "hangul": 14
  },
  {
   "id": 3840,
   "offset": 4066519,
   "text": "해례옴꺅포\n걸검\n꺅포냠너!",
   "unknown": 0,
   "hangul": 11
  },
  {
   "id": 3841,
   "offset": 4066557,
   "text": "티니카란타!",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3842,
   "offset": 4066565,
   "text": "\n\n검냠너!",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3843,
   "offset": 4066589,
   "text": "빰갗",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3844,
   "offset": 4066595,
   "text": "뜨뜨",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3845,
   "offset": 4066600,
   "text": "{var:01}걸검랴궐□\n고{var:03}\n□보끓!",
   "unknown": 2,
   "hangul": 7
  },
  {
   "id": 3846,
   "offset": 4066627,
   "text": "시타!",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3847,
   "offset": 4066631,
   "text": "셋",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 3848,
   "offset": 4066634,
   "text": "케",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 3849,
   "offset": 4066636,
   "text": "{var:03}\n포미\n미믄께걔몬덤낮함!",
   "unknown": 0,
   "hangul": 10
  },
  {
   "id": 3850,
   "offset": 4066663,
   "text": "{var:01}\n보견{var:03}\n미믄낮함!",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 3851,
   "offset": 4066684,
   "text": "{var:02}\n{var:01}\n넘공끓{var:03}!",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3852,
   "offset": 4066700,
   "text": "니이레타!",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3853,
   "offset": 4066706,
   "text": "공끓{var:02}!",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3854,
   "offset": 4066714,
   "text": "쿠시타!",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3855,
   "offset": 4066719,
   "text": "{var:01}교{var:02}\n향갚끓□뷔!",
   "unknown": 1,
   "hangul": 5
  },
  {
   "id": 3856,
   "offset": 4066738,
   "text": "이타노피아란타!",
   "unknown": 0,
   "hangul": 7
  },
  {
