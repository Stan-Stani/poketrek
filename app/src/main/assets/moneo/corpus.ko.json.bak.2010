   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3900,
   "offset": 4067092,
   "text": "공격",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3901,
   "offset": 4067097,
   "text": "방어",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3902,
   "offset": 4067102,
   "text": "민첩",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3903,
   "offset": 4067107,
   "text": "특공",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3904,
   "offset": 4067112,
   "text": "특방",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3905,
   "offset": 4067117,
   "text": "이",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 3906,
   "offset": 4067126,
   "text": "-이",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 3909,
   "offset": 4067143,
   "text": "렁렇\n\n",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3910,
   "offset": 4067149,
   "text": "□□끓몬\n걸검덥쁜!\n\n",
   "unknown": 2,
   "hangul": 6
  },
  {
   "id": 3912,
   "offset": 4067176,
   "text": "괘깊\n\n",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3913,
   "offset": 4067182,
   "text": "봉헥똑□!\n\n",
   "unknown": 1,
   "hangul": 3
  },
  {
   "id": 3914,
   "offset": 4067194,
   "text": "끼…?",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 3915,
   "offset": 4067199,
   "text": "\n껴넓끓!",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3916,
   "offset": 4067212,
   "text": "오있에타!",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3917,
   "offset": 4067219,
   "text": "아이우에오",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3918,
   "offset": 4067225,
   "text": "카키쿠케코",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3919,
   "offset": 4067231,
   "text": "사시스세소",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3920,
   "offset": 4067237,
   "text": "타치츠테토",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3921,
   "offset": 4067243,
   "text": "나니누네노",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3922,
   "offset": 4067249,
   "text": "하히후헤호",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3923,
   "offset": 4067255,
   "text": "마미무메모",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3924,
   "offset": 4067261,
   "text": "야유요!?",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3925,
   "offset": 4067267,
   "text": "라리루레로",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3926,
   "offset": 4067273,
   "text": "와트등-",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3927,
   "offset": 4067279,
   "text": "쿤는신화랐",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3928,
   "offset": 4067285,
   "text": "츄산팡퀸킹",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3929,
   "offset": 4067291,
   "text": "핏픽콘큐린",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3930,
   "offset": 4067297,
   "text": "밧섹폰냐안",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3931,
   "offset": 4067303,
   "text": "닷만윈뇨본",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3932,
   "offset": 4067309,
   "text": "윤딘완론날",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3933,
   "offset": 4067315,
   "text": "롯프쥬톤센",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3934,
   "offset": 4067321,
   "text": "겐랍그!?",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3935,
   "offset": 4067327,
   "text": "인낫혼몬진",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3936,
   "offset": 4067333,
   "text": "탓킨크-",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3948,
   "offset": 4067420,
   "text": "ㅎ우",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 3955,
   "offset": 4067493,
   "text": "히라제나",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3956,
   "offset": 4067498,
   "text": "츄밧츄닷",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3959,
   "offset": 4067511,
   "text": "엉뷔",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3960,
   "offset": 4067516,
   "text": "닫기",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3961,
   "offset": 4067520,
   "text": "겔겜끗?",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3962,
   "offset": 4067528,
   "text": "마스카?",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3963,
   "offset": 4067533,
   "text": "엉뷔공덜환?",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3965,
   "offset": 4067547,
   "text": "교뼘엉뷔끗?",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3967,
   "offset": 4067561,
   "text": "겨갱횟겸탁!",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3968,
   "offset": 4067573,
   "text": "이!",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 3969,
   "offset": 4067576,
   "text": "넉넋끓!",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3970,
   "offset": 4067586,
   "text": "마시타!",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3971,
   "offset": 4067591,
   "text": "댐끓",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3972,
   "offset": 4067598,
   "text": "몬:",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 3973,
   "offset": 4067606,
   "text": "던깊",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3974,
   "offset": 4067615,
   "text": "노히키메하이마세등",
   "unknown": 0,
   "hangul": 9
  },
  {
   "id": 3975,
   "offset": 4067628,
   "text": "던깊넉넋늙\n렁렇!",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 3976,
   "offset": 4067645,
   "text": "지우리즈우시마스!",
   "unknown": 0,
   "hangul": 8
  },
  {
   "id": 3977,
   "offset": 4067655,
   "text": "백걔댐끓\n고견템깃!",
   "unknown": 0,
   "hangul": 8
  },
  {
   "id": 3978,
   "offset": 4067676,
   "text": "등시마스!",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3979,
   "offset": 4067682,
   "text": "엉뷔렁렇\n참□다당□뷔끗?",
   "unknown": 2,
   "hangul": 9
  },
  {
   "id": 3980,
   "offset": 4067707,
   "text": "코미마스카?",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3981,
   "offset": 4067714,
   "text": "고포낮몬□뷔견템\n건걷끗?",
   "unknown": 1,
   "hangul": 10
  },
  {
   "id": 3982,
   "offset": 4067739,
   "text": "이이피스카?",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3983,
   "offset": 4067746,
   "text": "교참□다당□뷔\n간눈를꺄둘콷",
   "unknown": 2,
   "hangul": 11
  },
  {
   "id": 3984,
   "offset": 4067774,
   "text": "이피쿠베사이",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 3985,
   "offset": 4067782,
   "text": "\n뽀협끓□뷔!",
   "unknown": 1,
   "hangul": 4
  },
  {
   "id": 3986,
   "offset": 4067798,
   "text": "카키노코시타!",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 3987,
   "offset": 4067806,
   "text": "백걔겔겜끓\n계견건걷끗?",
   "unknown": 0,
   "hangul": 10
  },
  {
   "id": 3988,
   "offset": 4067831,
   "text": "시이피스카?",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3989,
   "offset": 4067838,
   "text": "곽꽁",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3990,
   "offset": 4067844,
   "text": "포켓몬",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3991,
   "offset": 4067849,
   "text": "경곁",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3992,
   "offset": 4067854,
   "text": "곽넌",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3993,
   "offset": 4067859,
   "text": "걸검",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3995,
   "offset": 4067868,
   "text": "끼…",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 3996,
   "offset": 4067873,
   "text": "끼",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 3997,
   "offset": 4067879,
   "text": "률률",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3998,
   "offset": 4067885,
   "text": "룩몸!",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3999,
   "offset": 4067891,
   "text": "{var:01}\n닿꿋홰년슭톨몬다당\n관꿈락굶몬\n몹꽁화공다당문개\n함갔할림!\n\n",
   "unknown": 0,
   "hangul": 26
  },
  {
   "id": 4001,
   "offset": 4067955,
   "text": "{var:01}\n닿꿋홰년슭톨몬다당\n관꿈락굶몬\n몹꽁화공멜륜\n꽁꽁몇눔!\n\n",
   "unknown": 0,
   "hangul": 24
  },
  {
   "id": 4002,
   "offset": 4068013,
   "text": "곤륜",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 4003,
   "offset": 4068022,
   "text": "사마",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 4004,
   "offset": 4068025,
   "text": "다당됩휴\n빅뻥런껼끓\n모□□□\n룩뼘꼬갗",
   "unknown": 3,
   "hangul": 14
  },
  {
   "id": 4005,
   "offset": 4068066,
   "text": "니시즈우메이시마스",
   "unknown": 0,
   "hangul": 9
  },
  {
   "id": 4006,
   "offset": 4068078,
   "text": "뚠문갯",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 4007,
   "offset": 4068086,
   "text": "림맏",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 4008,
   "offset": 4068091,
   "text": "덱더",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 4009,
   "offset": 4068096,
   "text": "림□몬뽀협□펫\n꼬문□끗?",
   "unknown": 3,
   "hangul": 8
  },
  {
   "id": 4010,
   "offset": 4068122,
   "text": "□교문□\n겨참미",
   "unknown": 2,
   "hangul": 5
  },
  {
   "id": 4011,
   "offset": 4068138,
   "text": "사이",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 4012,
   "offset": 4068141,
   "text": "주인공",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 4013,
   "offset": 4068151,
   "text": "플레이시간",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 4015,
   "offset": 4068163,
   "text": "포켓몬도감",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 4016,
   "offset": 4068173,
   "text": "마리",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 4017,
   "offset": 4068176,
   "text": "가진뱃지수",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 4019,
   "offset": 4068188,
   "text": "별뷔",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 4020,
   "offset": 4068193,
   "text": "루",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 4021,
   "offset": 4068195,
   "text": "□학끓\n{var:02}게꺽끓!",
   "unknown": 1,
   "hangul": 5
  },
  {
   "id": 4022,
   "offset": 4068212,
   "text": "타!",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 4023,
   "offset": 4068215,
   "text": "헌움게꺽몬{var:02}\n논문끝끗?",
   "unknown": 0,
   "hangul": 9
  },
  {
   "id": 4024,
   "offset": 4068239,
   "text": "던깊□최\n뚠문렁렇",
   "unknown": 1,
   "hangul": 7
  },
  {
   "id": 4025,
   "offset": 4068257,
   "text": "우리즈우시마스",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 4026,
   "offset": 4068265,
   "text": "겔겜끗?",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 4027,
   "offset": 4068273,
   "text": "마스카?",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 4028,
   "offset": 4068278,
   "text": "강갗BET뻐볶겔겜",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 4029,
   "offset": 4068305,
   "text": "둘멜",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 4030,
   "offset": 4068310,
   "text": "렁렇",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 4031,
   "offset": 4068315,
   "text": "몬핫",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 4032,
   "offset": 4068318,
   "text": "오시마이",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 4033,
   "offset": 4068323,
   "text": "돋띤넌널덥쁜",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 4034,
   "offset": 4068336,
   "text": "돋띤녀녁년녈",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 4035,
   "offset": 4068350,
   "text": "에테",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 4036,
   "offset": 4068353,
   "text": "돋띤놉놋몬길끕",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 4037,
   "offset": 4068368,
   "text": "테",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 4038,
   "offset": 4068370,
   "text": "나능다당",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 4039,
   "offset": 4068379,
   "text": "에타이",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 4040,
   "offset": 4068383,
   "text": "덱뻥똑□",
   "unknown": 1,
   "hangul": 3
  },
  {
   "id": 4041,
   "offset": 4068392,
   "text": "오시에테",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 4042,
   "offset": 4068398,
   "text": "나엉뷔겹겼",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 4043,
   "offset": 4068409,
   "text": "이",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 4044,
   "offset": 4068411,
   "text": "런",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 4045,
   "offset": 4068415,
   "text": "댑대댕\n곽꽁!\n\n꽁낸꺾승간□끼?\n곽꽁!!\n\n꽉관둘멜릍몬!\n\n",
   "unknown": 1,
   "hangul": 19
  },
  {
   "id": 4046,
   "offset": 4068466,
   "text": "나이부?\n코등니치하아-!!\n\n냐몬핫노오니이사등베요-!\n\n",
   "unknown": 0,
   "hangul": 20
  },
  {
   "id": 4047,
   "offset": 4068498,
   "text": "버례받꽉물돼\n궂다당\n\n뜻넌몬덥쁜!\n\n낮함문\n넓깊다당맡딛본게꽈!\n\n곽눈□속몬너검곽몬다당\n걸검금급욱끔\n\n닐곽덥다당\n\n냇냈갚네□봉쁜능공!\n\n꽁끓\n닐꽉겉겉곽몬꿇냈깃!\n\n게낳깃\n\n꽉건관믁비꼴댕\n견템!",
   "unknown": 2,
   "hangul": 78
  },
  {
   "id": 4048,
   "offset": 4068678,
   "text": "곽깨겹끗?\n\n멜먼몬다당\n냇냈꼭0캬\n\n간끔뜻넌\n\n꽥관교다당문개\n\n건걷할림다당냇냈!\n\n룩몸끓!\n\n곽관꿈꽁몬댑대댕!\n눈넋뼈끼!",
   "unknown": 0,
   "hangul": 47
  },
  {
   "id": 4049,
   "offset": 4068787,
   "text": "!\n이치니치이치비등트와스레바니!",
   "unknown": 0,
   "hangul": 14
  },
  {
   "id": 4050,
   "offset": 4068807,
   "text": "버례덱뻥\n녀녁년녈\n\n함갔강갗!\n\n녀녁년녈관발\n넴닛닝님닙□육……\n\n넣넣길끕\n\n녀녁년녈몬겊\n\n냇냈학듯\n\n꿈과꽁꽁뜻넌\n\n깐캬\n낯낯걱꿈꿋닻깃…\n\n깐격냉훤관꽁갸?\n\n돋띤곽깃!\n\n꽁끓게낳깃!\n\n꽉건관믁비꼴댕\n견템!",
   "unknown": 1,
   "hangul": 78
  },
  {
   "id": 4051,
   "offset": 4068993,
   "text": "도자아이쿠요!\n\n콘-차-오니이사등픽뮤-\n하-도마-루요-!",
   "unknown": 0,
   "hangul": 20
  },
  {
   "id": 4052,
   "offset": 4069026,
   "text": "게곧넴늘닛닝\n넌널렁렇미\n\n걱간넓꽁!\n\n독흩관문넴\n낮함몬캬□\n\n냇냈넓헙헙갚네\n\n검겹겼할림\n\n늘꿋교다당문개\n\n함갔할림!\n\n깨겹끓끗?\n꽁끓!\n\n곽관꿈꽁몬댑대댕!\n넋뼈끼!",
   "unknown": 1,
   "hangul": 64
  },
  {
   "id": 4053,
   "offset": 4069175,
   "text": "이치비등트와스레바니!",
   "unknown": 0,
   "hangul": 10
  },
  {
   "id": 4054,
   "offset": 4069189,
   "text": "냅보\n깨겹끗?\n\n다당늘늙욱끔\n\n깊놔놉놋놈놉놋넣\n\n꿈꾸급\n\n욱끔몬놉놋\n\n궂다당몬놉놋\n\n깊2콘냅보\n꽁남듯\n\n헌걷몬눑육관간괃몬\n\n냉록간깨겹\n낡간끔꿈꽁몬꺅포끼\n\n군개\n간눈믚뚝!\n\n게낳깃!\n\n꽉건관믁비꼴댕\n견템!",
   "unknown": 0,
   "hangul": 81
  },
  {
   "id": 4055,
   "offset": 4069374,
   "text": "마시즈우!\n\n도자아이쿠요!\n\n콘-차-오니이사등픽뮤-\n하-도마-루요-!",
   "unknown": 0,
   "hangul": 24
  },
  {
   "id": 4056,
   "offset": 4069413,
   "text": "끔걸검\n곽곽덥다당\n\n깊꼴눑육몬욱끔끗?\n\n눈군개!",
   "unknown": 0,
   "hangul": 19
  },
  {
   "id": 4057,
   "offset": 4069457,
   "text": "테노의퀸센크하\n코란치노의퀸센크니\n\n오오키나얀톤-덴트아타에루\n\n와데트베시소우카?\n\n시란카리미키와메테타타카오우!\n\n도자아마타네-란!\n\n만딘혼밧는반노오니이사등토하\n아이시즈우랑르섹낫노\n\n요이코밧는반노산프!\n\n이치니치이치비등트와스레바니!",
   "unknown": 0,
   "hangul": 104
  },
  {
   "id": 4058,
   "offset": 4069591,
   "text": "버례\n돋띤곽능다당몬덥쁜\n\n딥꽁끓!\n\n겉공끓덫꽂몬권꺽\n다당…\n\n꽁끓\n\n나능공끗!\n\n돋띤곽\n덥쁜!\n\n게낳깃!\n\n꽉건관믁비꼴댕\n견템!",
   "unknown": 0,
   "hangul": 47
  },
  {
   "id": 4059,
   "offset": 4069703,
   "text": "!\n\n도자아이쿠요!\n\n콘-차-오니이사등픽뮤-\n하-도마-루요-!",
   "unknown": 0,
   "hangul": 20
  },
  {
   "id": 4060,
   "offset": 4069738,
   "text": "1과능간문몬겊\n간눈겔겜\n\n꾸늬뇰과겉겉\n\n군것끔갔몬!\n\n꽁!\n\n게멀몬댑대댕!\n눈넋뼈끼!",
   "unknown": 0,
   "hangul": 32
  },
  {
   "id": 4061,
   "offset": 4069814,
   "text": "산프!\n이치니치이치비등트와스레바니!",
   "unknown": 0,
   "hangul": 16
  },
  {
   "id": 4062,
   "offset": 4069837,
   "text": "끼!\n꼬나눈똑□끗?\n\n다당\n□끓끔□멱욱끔\n\n깊캬□\n\n괘끔□쪄꿈더덕몬벌범!\n\n꿈덥북!\n\n겪견똑□풀\n꽁꽁겉겉꿀문\n\n똑□몬강갗!",
   "unknown": 7,
   "hangul": 41
  },
  {
   "id": 4063,
   "offset": 4069948,
   "text": "이란테이루와데롯픽크노\n\n세츠메이트요쿠미테미요우!",
   "unknown": 0,
   "hangul": 23
  },
  {
   "id": 4064,
   "offset": 4069977,
   "text": "낯낯『□녈놈놔…\n똑□걱깊놉놋\n\n닐냅보꽁몬다당\n다당□멱!\n\n꺅냉…\n놈묶점관놈놉놋\n\n급낀벌퇴관놔놉놋\n\n다당꼬끔□멱\n\n괘깊군콘!",
   "unknown": 4,
   "hangul": 46
  },
  {
   "id": 4065,
   "offset": 4070094,
   "text": "베이타이오있에루요\n\n소시테모우히토츠!",
   "unknown": 0,
   "hangul": 17
  },
  {
   "id": 4066,
   "offset": 4070116,
   "text": "간꽥관놉놋\n꽁꽁겉욱끔몬강갗\n\n닐닢닥닦□쪄몬다당\n\n걸검욱끔!\n\n꺅냉…\n뚜눔헴욱끔\n\n몰다당□다당\n\n간□닥닦□멱\n\n닐깊낙끔걸검헴낀몬다당\n포포겉깃!",
   "unknown": 4,
   "hangul": 56
  },
  {
   "id": 4067,
   "offset": 4070252,
   "text": "니타메시테미요우!",
   "unknown": 0,
   "hangul": 8
  },
  {
   "id": 4068,
   "offset": 4070263,
   "text": "강끓꿈꾸!\n꽁끓!\n\n게멀몬댑대댕!\n눈넋뼈끼!",
   "unknown": 0,
   "hangul": 16
  },
  {
   "id": 4069,
   "offset": 4070303,
   "text": "\n이치니치이치비등트와스레바니!",
   "unknown": 0,
   "hangul": 14
  },
  {
   "id": 4070,
   "offset": 4070322,
   "text": "댑대댕몬친□\n관꿈덥북몬뜸겼!\n\n맨긍득□몬겹겼\n간검군과과몬\n\n겪견친□\n\n낡건걷걸검!\n\n꺅냉낯낯몬친□\n깊희□둘멜…\n\n엉뷔몬겊\n\n낡건걷겉공끓빰갗!\n\n게낳깃!\n\n꽉건관믁비꼴댕\n…꽁끓\n\n견템!",
   "unknown": 5,
   "hangul": 68
  },
  {
   "id": 4071,
   "offset": 4070491,
   "text": "이사등픽뮤-\n…란테호푸피모나이케푸\n\n하도메마-스!",
   "unknown": 0,
   "hangul": 20
  },
  {
   "id": 4072,
   "offset": 4070520,
   "text": "희□둘멜\n『엉뷔』끓!\n\n등헉걸검갸?\n강갗릎깠픕쉬꿋\n\n『맨긍득□몬겹겼\n엉뷔몬겊\n\n쁨갱횟감\n\n낡건걷걸검……』\n\n희□둘멜\n깨겹끗!\n\n곽핸훤캬□쁨감\n\n꼬갔몬!\n\n간눈□끓!\n\n꽁끓!\n\n게멀몬댑대댕!\n눈넋뼈끼!",
   "unknown": 5,
   "hangul": 67
  },
  {
   "id": 4073,
   "offset": 4070694,
   "text": "에테시마우!\n\n나등베카테레치자우네!\n\n도자아마타네-란!\n\n요이코안몬-닷-노산프!\n이치니치이치비등트와스레바니!핵딨",
   "unknown": 0,
   "hangul": 47
  },
  {
   "id": 4074,
   "offset": 4070762,
   "text": "밝",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 4075,
   "offset": 4070766,
   "text": "깍",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 4078,
   "offset": 4070775,
   "text": "과",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 4079,
   "offset": 4070778,
   "text": "검다당□즙몬□뷔",
   "unknown": 2,
   "hangul": 6
  },
  {
   "id": 4080,
   "offset": 4070795,
   "text": "몹껌□즙과□",
   "unknown": 2,
   "hangul": 4
  },
  {
   "id": 4081,
   "offset": 4070809,
   "text": "몹껌넘늑",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 4082,
   "offset": 4070819,
   "text": "육믄EXCELLENT",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 4083,
   "offset": 4070834,
   "text": "껼놀꿈꽁\n헌콘뜻꼭맥긋!",
   "unknown": 0,
   "hangul": 10
  },
  {
   "id": 4084,
   "offset": 4070862,
