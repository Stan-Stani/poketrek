  {
   "id": 1126,
   "offset": 3944919,
   "text": "베!",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 1127,
   "offset": 3944922,
   "text": "견템논□잘끓!",
   "unknown": 1,
   "hangul": 5
  },
  {
   "id": 1128,
   "offset": 3944937,
   "text": "□잘넬끓",
   "unknown": 1,
   "hangul": 3
  },
  {
   "id": 1129,
   "offset": 3944946,
   "text": "아레루",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 1130,
   "offset": 3944950,
   "text": "□잘뻐볶끓!",
   "unknown": 1,
   "hangul": 4
  },
  {
   "id": 1132,
   "offset": 3944964,
   "text": "컴묶학넬!",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 1133,
   "offset": 3944974,
   "text": "타!",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 1134,
   "offset": 3944977,
   "text": "컴묶꿈넬",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 1135,
   "offset": 3944986,
   "text": "컴묶학돗끓!",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 1136,
   "offset": 3944999,
   "text": "견템갚□□!",
   "unknown": 2,
   "hangul": 3
  },
  {
   "id": 1137,
   "offset": 3945012,
   "text": "□□뿐믄몬갚",
   "unknown": 2,
   "hangul": 4
  },
  {
   "id": 1138,
   "offset": 3945026,
   "text": "□□뻐끓!",
   "unknown": 2,
   "hangul": 2
  },
  {
   "id": 1140,
   "offset": 3945038,
   "text": "꽥관꼬겔간게꽈!",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 1142,
   "offset": 3945056,
   "text": "낚헉꼬뇌□간끓!",
   "unknown": 1,
   "hangul": 6
  },
  {
   "id": 1144,
   "offset": 3945074,
   "text": "학껼쌥렘끓!",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 1145,
   "offset": 3945086,
   "text": "타!",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 1146,
   "offset": 3945089,
   "text": "림□몬녀녁화공걷낮!",
   "unknown": 1,
   "hangul": 8
  },
  {
   "id": 1148,
   "offset": 3945111,
   "text": "낱낳끓!",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 1149,
   "offset": 3945119,
   "text": "니치라페란타!",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 1150,
   "offset": 3945128,
   "text": "눈늑롤냇냈간□!",
   "unknown": 1,
   "hangul": 6
  },
  {
   "id": 1151,
   "offset": 3945144,
   "text": "이리즈쿠제타리나카란타!",
   "unknown": 0,
   "hangul": 11
  },
  {
   "id": 1152,
   "offset": 3945158,
   "text": "늑넘끓냄냅몬냇냈!",
   "unknown": 0,
   "hangul": 8
  },
  {
   "id": 1153,
   "offset": 3945176,
   "text": "타!",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 1154,
   "offset": 3945179,
   "text": "견템끓□딤!",
   "unknown": 1,
   "hangul": 4
  },
  {
   "id": 1155,
   "offset": 3945191,
   "text": "타!",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 1156,
   "offset": 3945194,
   "text": "냄냅몬다당3화슴간갔끓!",
   "unknown": 0,
   "hangul": 10
  },
  {
   "id": 1157,
   "offset": 3945217,
   "text": "마우!",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 1158,
   "offset": 3945221,
   "text": "던깊끓욱끔넛!\n\n",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 1160,
   "offset": 3945239,
   "text": "건관\n욱끔넛던깊끓!",
   "unknown": 0,
   "hangul": 8
  },
  {
   "id": 1161,
   "offset": 3945258,
   "text": "란타!",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 1162,
   "offset": 3945262,
   "text": "{var:0F}교닙룹까간딥겊!",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 1163,
   "offset": 3945280,
   "text": "시시타!",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 1164,
   "offset": 3945285,
   "text": "{var:0F}간딥겊!",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 1165,
   "offset": 3945295,
   "text": "무시시타!",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 1166,
   "offset": 3945301,
   "text": "{var:0F}견템닙룹!",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 1167,
   "offset": 3945313,
   "text": "타!",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 1168,
   "offset": 3945316,
   "text": "{var:0F}교곤!",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 1169,
   "offset": 3945324,
   "text": "이루!",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 1170,
   "offset": 3945328,
   "text": "{var:0F}간딥겊!",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 1171,
   "offset": 3945338,
   "text": "키카나이!",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 1172,
   "offset": 3945344,
   "text": "{var:0F}교군띠!",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 1173,
   "offset": 3945354,
   "text": "이타!",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 1174,
   "offset": 3945358,
   "text": "{var:0F}간깨겹!",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 1175,
   "offset": 3945368,
   "text": "타!",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 1176,
   "offset": 3945371,
   "text": "{var:1C}{var:1D}는「은」\n{var:01}포내려한다\n\n{var:23}는「은」포켓몬을\n바꿀까요?",
   "unknown": 0,
   "hangul": 17
  },
  {
   "id": 1177,
   "offset": 3945414,
   "text": "{var:0F}\n껴넓끓{var:00}!",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 1178,
   "offset": 3945428,
   "text": "{var:1C}{var:1D}와의\n승부에서이겼다!\n\n",
   "unknown": 0,
   "hangul": 9
  },
  {
   "id": 1179,
   "offset": 3945450,
   "text": "{var:23}\n곽{var:06}늬딧백!",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 1181,
   "offset": 3945467,
   "text": "{var:23}\n곽{var:06}늬생긋!",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 1183,
   "offset": 3945484,
   "text": "{var:06}\n꿈껌빵몬픕낀!",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 1184,
   "offset": 3945501,
   "text": "란테이루!",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 1185,
   "offset": 3945507,
   "text": "{var:06}\n꿈꺽뚜!",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 1186,
   "offset": 3945519,
   "text": "{var:06}\n교획생긋!",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 1188,
   "offset": 3945534,
   "text": "보□커□『끼!\n맷꼬닉던끓\n\n렁렇깃!\n\n",
   "unknown": 2,
   "hangul": 11
  },
  {
   "id": 1189,
   "offset": 3945569,
   "text": "지우리즈우피-스!\n\n",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 1190,
   "offset": 3945580,
   "text": "아!야생의\n{var:06}가「이」나타나다!\n\n",
   "unknown": 0,
   "hangul": 10
  },
  {
   "id": 1191,
   "offset": 3945602,
   "text": "야생의\n{var:06}가나타나다!",
   "unknown": 0,
   "hangul": 8
  },
  {
   "id": 1193,
   "offset": 3945622,
   "text": "야생의\n{var:06}가나타나다!브",
   "unknown": 0,
   "hangul": 9
  },
  {
   "id": 1194,
   "offset": 3945642,
   "text": "브",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 1195,
   "offset": 3945646,
   "text": "권꺽몬\n{var:06}궂{var:08}게꽈끓!",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 1196,
   "offset": 3945667,
   "text": "키타!\n\n",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 1197,
   "offset": 3945672,
   "text": "법껄게꽈끓!\n\n법껄다당몬길끕\n괘간깨겹!\n\n",
   "unknown": 0,
   "hangul": 16
  },
  {
   "id": 1198,
   "offset": 3945710,
   "text": "라나이!\n\n",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 1199,
   "offset": 3945716,
   "text": "법껄게꽈끓!\n\n",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 1200,
   "offset": 3945730,
   "text": "검덩방뚜딨\n꿈뻥법껄낱낳!",
   "unknown": 0,
   "hangul": 11
  },
  {
   "id": 1201,
   "offset": 3945755,
   "text": "란타!",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 1202,
   "offset": 3945759,
   "text": "법껄녀녁\n간꽁!",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 1203,
   "offset": 3945774,
   "text": "움인베란타!\n\n",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 1204,
   "offset": 3945783,
   "text": "{var:1C}의{var:1D}가「이」\n승부를걸었다\n\n",
   "unknown": 0,
   "hangul": 9
  },
  {
   "id": 1205,
   "offset": 3945806,
   "text": "{var:20}\n꽈꺅포냠□끓!",
   "unknown": 1,
   "hangul": 5
  },
  {
   "id": 1206,
   "offset": 3945824,
   "text": "{var:20}궂{var:21}\n꽈꺅포냠□끓!",
   "unknown": 1,
   "hangul": 6
  },
  {
   "id": 1207,
   "offset": 3945846,
   "text": "{var:1C}{var:1D}는「은」\n{var:06}포냈다!",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 1208,
   "offset": 3945865,
   "text": "{var:1C}{var:1D}\n걸검끓{var:06}궂{var:08}!",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 1209,
   "offset": 3945884,
   "text": "시타!",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 1210,
   "offset": 3945888,
   "text": "{var:1C}{var:1D}는「은」\n{var:00}포냈다!",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 1211,
   "offset": 3945907,
   "text": "{var:20}는\n{var:06}사용했다!",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 1213,
   "offset": 3945922,
   "text": "{var:20}\n걸검끓{var:06}궂{var:08}!",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 1215,
   "offset": 3945941,
   "text": "{var:20}걸검끓{var:0A}!\n{var:21}걸검끓{var:0C}!",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 1216,
   "offset": 3945965,
   "text": "리베시타!",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 1217,
   "offset": 3945971,
   "text": "{var:20}는\n{var:00}사용했다!",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 1219,
   "offset": 3945986,
   "text": "{var:22}는\n{var:00}사용했다!",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 1221,
   "offset": 3946001,
   "text": "가라!{var:05}!",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 1222,
   "offset": 3946010,
   "text": "게낳{var:05}궂{var:07}!",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 1223,
   "offset": 3946023,
   "text": "가라!{var:00}!",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 1224,
   "offset": 3946032,
   "text": "게꽈깃{var:00}!",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 1225,
   "offset": 3946043,
   "text": "넋뼈{var:00}!",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 1227,
   "offset": 3946053,
   "text": "곽낙꿈돗!\n벌넓꽈끓!{var:00}!",
   "unknown": 0,
   "hangul": 8
  },
  {
   "id": 1228,
   "offset": 3946077,
   "text": "{var:1F}걸검끓{var:0B}!\n게낳!{var:09}!",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 1229,
   "offset": 3946101,
   "text": "{var:00}\n화꽈깃",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 1230,
   "offset": 3946111,
