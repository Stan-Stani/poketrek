  },
  {
   "id": 1303,
   "offset": 3946844,
   "text": "아레테이루",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 1304,
   "offset": 3946850,
   "text": "려낀□끓\n간끔룩능끓!\n\n",
   "unknown": 1,
   "hangul": 8
  },
  {
   "id": 1305,
   "offset": 3946872,
   "text": "에라레나이!\n\n",
   "unknown": 0,
