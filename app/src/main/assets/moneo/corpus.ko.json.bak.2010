   "hangul": 25
  },
  {
   "id": 1274,
   "offset": 3946431,
   "text": "할아버지는\n{var:16}을사용했다!",
   "unknown": 0,
   "hangul": 10
  },
  {
   "id": 1275,
   "offset": 3946449,
   "text": "낯낯\n걸검끓{var:16}!",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 1276,
   "offset": 3946464,
   "text": "타!",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 1277,
   "offset": 3946467,
   "text": "{var:1C}몬{var:1D}\n걸검끓{var:16}!",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 1278,
   "offset": 3946485,
   "text": "놔댑대댕넘공닉!",
