   "hangul": 8
  },
  {
   "id": 5251,
   "offset": 4292341,
   "text": "{var:02}「{var:01}\n꽉끈교함갔뚝슴뚠문\n\n군논곤깃?",
   "unknown": 0,
   "hangul": 13
  },
  {
   "id": 5252,
   "offset": 4292379,
   "text": "시나이?",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 5253,
   "offset": 4292385,
   "text": "겐크베쿠R크베쿠르크베쿠베쿠……\n교참□문\n\n",
   "unknown": 1,
   "hangul": 16
  },
  {
   "id": 5254,
   "offset": 4292417,
   "text": "우노요우베\n\n",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 5255,
   "offset": 4292425,
   "text": "곽넌!\n□꽁끓넣군넣!",
   "unknown": 1,
   "hangul": 7
  },
  {
   "id": 5257,
   "offset": 4292451,
   "text": "뚝슴뚠문!\n넣군넣!",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 5258,
   "offset": 4292470,
   "text": "마란테테!",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 5259,
   "offset": 4292476,
   "text": "꽁몬\n겉댑대댕밋분깃",
   "unknown": 0,
   "hangul": 9
  },
  {
   "id": 5260,
   "offset": 4292496,
   "text": "몬-닷-츄-블트미세테아디루요",
   "unknown": 0,
   "hangul": 12
  },
  {
   "id": 5261,
   "offset": 4292513,
   "text": "곽넌!\n넣군넣!",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 5262,
   "offset": 4292530,
   "text": "토마란테테!",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 5263,
   "offset": 4292538,
   "text": "뚝슴뚠문!\n넣군넣!",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 5264,
   "offset": 4292558,
   "text": "마란테테!",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 5265,
   "offset": 4292564,
   "text": "벤□렁렇\n낡헌겉댑대댕밋분깃",
   "unknown": 1,
   "hangul": 12
  },
  {
   "id": 5266,
   "offset": 4292592,
   "text": "아디루네",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 5267,
   "offset": 4292597,
   "text": "돈브베쿠안브베쿠탓브베쿠3브베쿠B브베쿠Z브베쿠섹톰르안베네!\n와카란타치즈란토마란테테!",
   "unknown": 0,
   "hangul": 39
  },
  {
   "id": 5268,
   "offset": 4292656,
   "text": "□넣끓!\n곽넌깃!데",
   "unknown": 1,
   "hangul": 6
  },
  {
   "id": 5269,
   "offset": 4292675,
   "text": "요우카!데",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 5270,
   "offset": 4292683,
   "text": "꽁몬\n군논곤뚝슴뚠문깃!데",
   "unknown": 0,
