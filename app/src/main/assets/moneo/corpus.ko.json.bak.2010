  },
  {
   "id": 1044,
   "offset": 3943771,
   "text": "{var:10}몬{var:19}\n{var:0F}좌육끓!",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 1046,
   "offset": 3943790,
   "text": "{var:13}림괅끓{var:00}\n{var:01}!",
