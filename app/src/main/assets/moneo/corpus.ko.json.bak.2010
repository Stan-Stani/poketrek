   "hangul": 14
  },
  {
   "id": 2873,
   "offset": 4054596,
   "text": "{var:02}는「은」도구를\n가지고있지않다!",
   "unknown": 0,
   "hangul": 12
  },
  {
   "id": 2874,
   "offset": 4054621,
   "text": "{var:02}에게서\n{var:03}를맡았다!",
