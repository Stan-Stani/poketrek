   "text": "이레루",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 4990,
   "offset": 4281160,
   "text": "꼴□특튼\n건걷함띨",
   "unknown": 1,
   "hangul": 7
  },
  {
   "id": 4991,
