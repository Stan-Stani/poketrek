   "text": "눔맘군귤",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3877,
   "offset": 4066902,
   "text": "템문냅댕몬륜",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 3878,
   "offset": 4066915,
   "text": "낵덩될됨",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3879,
   "offset": 4066924,
   "text": "낵덩개텝",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3880,
   "offset": 4066934,
   "text": "딤따뚠문텔",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3881,
   "offset": 4066947,
   "text": "생눕",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3882,
   "offset": 4066953,
   "text": "딤따발심□",
   "unknown": 1,
   "hangul": 4
  },
  {
   "id": 3883,
   "offset": 4066965,
   "text": "맷꼬먹",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3884,
   "offset": 4066973,
   "text": "먹껴륜",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3885,
   "offset": 4066980,
   "text": "에",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 3886,
   "offset": 4066982,
   "text": "섬널댕",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3887,
   "offset": 4066989,
   "text": "즈우",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3888,
   "offset": 4066992,
   "text": "덩방개□",
   "unknown": 1,
   "hangul": 3
  },
  {
   "id": 3889,
   "offset": 4067001,
   "text": "낀□",
   "unknown": 1,
   "hangul": 1
  },
  {
   "id": 3890,
   "offset": 4067007,
   "text": "다당귤",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3891,
   "offset": 4067015,
   "text": "다당끊끌느",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3892,
   "offset": 4067027,
   "text": "챔피먼로드",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3893,
   "offset": 4067037,
   "text": "당밀밈",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3894,
   "offset": 4067045,
   "text": "깐낵궐처",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3895,
   "offset": 4067054,
   "text": "트\n",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 3896,
   "offset": 4067057,
   "text": "걸검끓",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3897,
   "offset": 4067064,
   "text": "몬넣비",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3898,
   "offset": 4067071,
   "text": "같넥끓!",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3899,
