   "hangul": 9
  },
  {
   "id": 2804,
   "offset": 4053733,
   "text": "꽁끓\n률률묶년",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 2805,
   "offset": 4053747,
   "text": "률률!\n푥찼공멜륜둘둠!",
   "unknown": 0,
   "hangul": 9
  },
  {
   "id": 2806,
   "offset": 4053769,
   "text": "률률!\n푥찼공멜륜둘둠!",
   "unknown": 0,
   "hangul": 9
  },
  {
   "id": 2807,
   "offset": 4053791,
   "text": "우모아리제토우!\n도타쿠노차린킹크니오쿠란테오쿠네!",
