   "hangul": 11
  },
  {
   "id": 1013,
   "offset": 3943297,
   "text": "{var:10}\n놔믿게넌널!\n\n",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 1014,
   "offset": 3943313,
   "text": "레타!\n\n",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 1015,
   "offset": 3943318,
   "text": "줄줌듯끓!",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 1016,
   "offset": 3943328,
   "text": "꽥관던깊눈록!",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 1017,
   "offset": 3943343,
   "text": "{var:12}던깊욱끔!\n\n",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 1018,
   "offset": 3943356,
   "text": "\n와데제나이!\n\n",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 1019,
   "offset": 3943366,
   "text": "{var:12}검월장\n간끔걸게{var:14}!\n\n",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 1020,
   "offset": 3943388,
   "text": "{var:12}검끓짧갯땋걔\n간끔미믄걸검냅괃몬욱끔!",
   "unknown": 0,
   "hangul": 17
  },
  {
   "id": 1021,
   "offset": 3943427,
   "text": "{var:12}놔밖갤\n간끔걸검{var:14}!\n\n",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 1023,
   "offset": 3943452,
   "text": "{var:12}검늑쫓\n간끔걸게{var:14}\n\n",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 1024,
   "offset": 3943473,
   "text": "걸검{var:13}몬{var:1A}\n견걸갚짜",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 1025,
   "offset": 3943493,
   "text": "{var:13}검{var:1A}\n전절같넥끓!",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 1026,
   "offset": 3943513,
   "text": "{var:10}검{var:19}\n던눈록!",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 1027,
   "offset": 3943529,
   "text": "{var:10}몬{var:19}\n{var:0F}\n\n{var:14}간끔검!",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 1029,
   "offset": 3943551,
   "text": "{var:10}검{var:19}\n할림끓!",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 1030,
   "offset": 3943567,
   "text": "{var:10}몬{var:19}\n{var:14}던깊눈록!",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 1031,
   "offset": 3943586,
   "text": "란타!",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 1032,
   "offset": 3943590,
   "text": "{var:10}몬{var:19}\n학껼{var:00}놉놋!",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 1033,
   "offset": 3943610,
