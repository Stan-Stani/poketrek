   "text": "□뚜학꼴끓!",
   "unknown": 1,
   "hangul": 4
  },
  {
   "id": 1004,
   "offset": 3943197,
   "text": "로제란타!",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 1005,
   "offset": 3943203,
   "text": "교깠환젤짐\n간끔걸검!부",
   "unknown": 0,
   "hangul": 10
  },
  {
   "id": 1006,
   "offset": 3943227,
   "text": "쿠부",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 1007,
   "offset": 3943230,
   "text": "{var:16}곽{var:13}\n{var:00}",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 1009,
   "offset": 3943242,
   "text": "{var:13}는\n{var:16}사용했다!",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 1010,
   "offset": 3943255,
   "text": "하리키리베시타!",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 1011,
   "offset": 3943265,
   "text": "{var:0F}\n간끔걸검욱끔!",
