   "text": ":아:아:아:아:아:아:아:아",
   "unknown": 0,
   "hangul": 8
  },
  {
   "id": 5641,
   "offset": 4357609,
   "text": ":아:아:아:아:아:아:아:아켄팜아걸검껴위눔\n늘낙\n□겪빡갯\n낱낳。",
   "unknown": 1,
   "hangul": 23
  },
  {
   "id": 5642,
   "offset": 4357688,
   "text": "검월너몬꼴랄\n윗겪곽낙\n낱낳。\n병문묻\n꿈껌。",
   "unknown": 0,
   "hangul": 17
  },
  {
   "id": 5643,
   "offset": 4357748,
   "text": "겪낳\n곽낙\n낱낳。\n2-5화슴육믄\n헌걷눑육。",
   "unknown": 0,
   "hangul": 14
  },
  {
   "id": 5644,
   "offset": 4357808,
   "text": "검헴낀\n믿겪빡갯\n낱낳。\n2-5화슴육믄\n헌걷눑육。",
   "unknown": 0,
   "hangul": 17
  },
  {
   "id": 5645,
   "offset": 4357868,
   "text": "검깊냈너몬\n냈너헴낀\n믿겪빡갯\n낱낳。",
   "unknown": 0,
   "hangul": 15
  },
  {
   "id": 5646,
   "offset": 4357928,
   "text": "늬□\n께곽낙\n낱낳。\n넌널포미\n넘공앨덮。",
   "unknown": 1,
   "hangul": 14
  },
  {
   "id": 5647,
   "offset": 4357988,
   "text": "검□음딤으몬\n헴낀\n낱낳곽낙。\n깊캬넓게곧\n□육녀녁。",
   "unknown": 2,
   "hangul": 19
  },
  {
   "id": 5648,
   "offset": 4358048,
   "text": "검서팟몬\n헴낀\n낱낳곽낙。\n깊캬넓게곧\n서켓녀녁。",
   "unknown": 0,
   "hangul": 19
  },
  {
   "id": 5649,
   "offset": 4358108,
   "text": "검닿둘몬\n헴낀께곽낙\n낱낳。\n깊캬넓게곧\n닛닝녀녁。",
   "unknown": 0,
   "hangul": 20
  },
  {
   "id": 5650,
   "offset": 4358168,
   "text": "걸검\n을너몬\n발랄\n낱낳곽낙。",
   "unknown": 0,
   "hangul": 11
  },
  {
   "id": 5651,
   "offset": 4358228,
   "text": "걸검\n꼴헴\n음낳곽낙\n낱낳。",
   "unknown": 0,
   "hangul": 10
  },
  {
   "id": 5652,
   "offset": 4358288,
   "text": "검꼴헴\n헴곽낙\n함갔낱낳。\n닐빡갯\n간끔넌널。",
   "unknown": 0,
   "hangul": 17
  },
  {
   "id": 5653,
   "offset": 4358348,
   "text": "낮1화슴\n괅렘읍\n교갚화슴。\n함갔낱낳\n꿈더덕。",
   "unknown": 0,
   "hangul": 17
  },
  {
   "id": 5654,
   "offset": 4358408,
   "text": "□넘\n꿈껌\n걔몬관\n늘멜먼몬낱낳\n선껌。",
   "unknown": 1,
   "hangul": 14
  },
  {
   "id": 5655,
   "offset": 4358468,
   "text": "검을너긋\n냉발랄넣\n낱낳。\n끔를꺄\n□몬려늘놔。",
   "unknown": 1,
   "hangul": 17
  },
  {
   "id": 5656,
   "offset": 4358528,
   "text": "검힘□\n원논넬렘\n께곽낙\n낱낳。",
   "unknown": 1,
   "hangul": 11
  },
  {
   "id": 5657,
   "offset": 4358588,
   "text": "꼴꼴몬\n랠견힘□\n믹낳빡갯\n낱낳。",
   "unknown": 1,
   "hangul": 12
  },
  {
   "id": 5658,
   "offset": 4358648,
   "text": "께곽낙\n떨게넬렘\n겪낳빡갯。\n뒤뎌몬\n렁렇넌널。",
   "unknown": 0,
   "hangul": 18
  },
  {
   "id": 5659,
   "offset": 4358708,
   "text": "□1화슴\n눗같례\n갚콘화슴낱낳。\n끔혹화공\n뚱꺼깨겹몬엠버。",
   "unknown": 1,
   "hangul": 22
  },
  {
   "id": 5660,
   "offset": 4358768,
   "text": "걸검\n껴확\n2-5화슴\n헬믥빡갯\n낱낳。",
   "unknown": 0,
   "hangul": 12
  },
  {
   "id": 5661,
   "offset": 4358828,
   "text": "검껴위눔\n껴확\n딣임곽낙\n낱낳。",
   "unknown": 0,
   "hangul": 12
  },
  {
   "id": 5662,
   "offset": 4358888,
   "text": "검껴입\n헬믥\n께곽낙\n낱낳。",
   "unknown": 0,
   "hangul": 10
  },
  {
   "id": 5663,
   "offset": 4358948,
   "text": "검꼴□\n□흰빡갯\n낱낳。\n깊캬닐곽낙\n□련。",
   "unknown": 3,
   "hangul": 13
  },
  {
   "id": 5664,
   "offset": 4359008,
   "text": "검잊□\n믿겪곽낙\n낱낳。\n끔육믄2과\n헌걷눑육。",
   "unknown": 1,
   "hangul": 16
  },
  {
   "id": 5665,
   "offset": 4359068,
   "text": "럭긴\n더덕냈너\n께곽낙\n낱낳。",
   "unknown": 0,
   "hangul": 11
  },
  {
   "id": 5666,
   "offset": 4359128,
   "text": "옷검뚜잎\n께곽낙\n낱낳。\n간문몬겊\n멜먼깊눑육。",
   "unknown": 0,
   "hangul": 18
  },
  {
   "id": 5667,
   "offset": 4359188,
   "text": "뎌애딕갤롤냇\n께곽낙\n낱낳。\n깊캬닐곽낙\n□련。",
   "unknown": 1,
   "hangul": 17
  },
  {
   "id": 5668,
   "offset": 4359248,
   "text": "늬꼴너몬□낀\n걸빡갯버□\n끔작동곽낙몬\n낱낳。",
   "unknown": 2,
   "hangul": 17
  },
  {
   "id": 5669,
   "offset": 4359308,
   "text": "검둠□\n믹낳\n낱낳。\n깊캬빡갯\n넓련。",
   "unknown": 1,
   "hangul": 12
  },
  {
   "id": 5670,
   "offset": 4359368,
   "text": "걸검덤\n휨휨몬\n믹낳곽낙\n낱낳。",
   "unknown": 0,
   "hangul": 12
  },
  {
   "id": 5671,
   "offset": 4359428,
   "text": "검덤늘□\n헴곽낙\n낱낳。\n2-5화슴육믄\n헌걷눑육。",
   "unknown": 1,
   "hangul": 16
  },
  {
   "id": 5672,
   "offset": 4359488,
   "text": "딕갤밤덤\n께곽낙\n낱낳。\n병문몬겊\n빡갯간끔넌널。",
   "unknown": 0,
   "hangul": 19
  },
  {
   "id": 5673,
   "offset": 4359548,
   "text": "걸검롤냇\n림□몬냈너\n믹낳빡갯\n낱낳。",
   "unknown": 1,
   "hangul": 14
  },
  {
   "id": 5674,
   "offset": 4359608,
   "text": "원논롤냇\n께곽낙\n낱낳。\n깊캬걸빡갯\n닛닝。",
   "unknown": 0,
   "hangul": 16
  },
  {
   "id": 5675,
   "offset": 4359668,
   "text": "검껴껴몬롤냇\n늘확\n2-5화슴\n헬믥곽낙\n낱낳。",
   "unknown": 0,
   "hangul": 16
  },
  {
   "id": 5676,
   "offset": 4359728,
   "text": "검뚜냈\n믹낳빡갯\n낱낳。\n멜먼\n걱깊군몬눑육。",
   "unknown": 0,
   "hangul": 17
  },
  {
   "id": 5677,
   "offset": 4359788,
   "text": "2-3화슴\n뿐믄잘냈\n낱낳。\n낱낳미\n넓뚝잠。",
   "unknown": 0,
   "hangul": 14
  },
  {
   "id": 5678,
   "offset": 4359848,
   "text": "잡병\n믹낳빡갯\n낱낳。\n멜먼걱깊\n군몬눑육。",
   "unknown": 0,
   "hangul": 16
  },
  {
   "id": 5679,
   "offset": 4359908,
   "text": "심갤위눔\n낱낳\n걸빡갯\n잣□갚네。",
   "unknown": 1,
   "hangul": 12
  },
  {
   "id": 5680,
   "offset": 4359968,
   "text": "검넴□\n늘넴덤\n낱낳。\n깊캬걸빡갯\n문넴。",
   "unknown": 1,
   "hangul": 14
  },
  {
   "id": 5681,
   "offset": 4360028,
   "text": "걸검잊장\n2과육믄\n낱낳。\n깊캬걸빡갯\n문넴。",
   "unknown": 0,
   "hangul": 16
  },
  {
   "id": 5682,
   "offset": 4360088,
   "text": "떨잤\n을너장\n낱낳。\n2-5화슴육믄\n헌걷눑육。",
   "unknown": 0,
   "hangul": 15
  },
  {
   "id": 5683,
   "offset": 4360148,
   "text": "검□승\n듭빡갯\n걸빡갯\n잣□갚네。",
   "unknown": 2,
   "hangul": 11
  },
  {
   "id": 5684,
   "offset": 4360208,
   "text": "검을너몬□\n압빡갯\n낱낳。\n곽낙깊캬\n넓련。",
   "unknown": 1,
   "hangul": 15
  },
  {
   "id": 5685,
   "offset": 4360268,
   "text": "닐빡갯\n딥공재밴몬잭딤\n동견빡갯몬\n낱낳。",
   "unknown": 0,
   "hangul": 17
  },
  {
   "id": 5686,
   "offset": 4360328,
   "text": "동견곽낙\n럽학\n다당。\n권꺽넌널캬\n넌널렁렇。",
   "unknown": 0,
   "hangul": 17
  },
  {
   "id": 5687,
   "offset": 4360388,
   "text": "검갤딥몬\n잭딤\n닐빡갯\n꿈뻥님닙몬\n녀녁。",
   "unknown": 0,
   "hangul": 16
  },
  {
   "id": 5688,
   "offset": 4360448,
   "text": "롤냇떨게\n떳독몬땀낼\n걸곽낙\n녀녁뚝잠。",
   "unknown": 0,
   "hangul": 16
  },
  {
   "id": 5689,
   "offset": 4360508,
   "text": "검□낳낼\n께빡갯\n낱낳。\n헌걷20몬\n눑육。",
   "unknown": 1,
   "hangul": 13
  },
  {
   "id": 5690,
   "offset": 4360568,
   "text": "붉짧\n곽낙몬갔갤\n닐곽낙몬욱끔\n□화슴□\n간끔걸검。",
   "unknown": 2,
   "hangul": 19
  },
  {
   "id": 5691,
   "offset": 4360628,
   "text": "께빡갯\n숲□\n낱낳。\n걸곽낙잣□\n잣□갚네。",
   "unknown": 3,
   "hangul": 13
  },
  {
   "id": 5692,
   "offset": 4360688,
   "text": "늘군딤으\n께곽낙떨잤\n낱낳。\n깊캬게곧\n□육녀녁。",
   "unknown": 1,
   "hangul": 18
  },
  {
   "id": 5693,
   "offset": 4360748,
   "text": "검쇄박몬딤으\n께곽낙떨잤\n낱낳。\n깊캬게곧\n□육녀녁。",
   "unknown": 1,
   "hangul": 20
  },
  {
   "id": 5694,
   "offset": 4360808,
   "text": "럼를\n빡갯롤냇\n간끔걸\n끔냈\n갚네。",
   "unknown": 0,
   "hangul": 13
  },
  {
   "id": 5695,
   "offset": 4360868,
   "text": "고□환\n않게놈솜\n께곽낙떨잤\n낱낳。",
   "unknown": 1,
   "hangul": 13
  },
  {
   "id": 5696,
   "offset": 4360928,
   "text": "늘꼴너몬놈\n검꼴몬뚜냈\n께곽낙떨잤\n낱낳。",
   "unknown": 0,
   "hangul": 17
  },
  {
   "id": 5697,
   "offset": 4360988,
   "text": "원논놈□\n검꿈더덕몬냈너\n낱낳。\n깊캬□\n건걷멁놈낮함。",
   "unknown": 2,
   "hangul": 20
  },
  {
   "id": 5698,
   "offset": 4361048,
   "text": "떨잤팟뚜\n께곽낙\n낱낳。\n깊캬끔깊\n서켓녀녁。",
   "unknown": 0,
   "hangul": 17
  },
  {
   "id": 5699,
   "offset": 4361108,
   "text": "쇄박몬서□\n낑른넬렘\n낱낳。\n깊캬끔깊\n서켓녀녁。",
   "unknown": 1,
   "hangul": 18
  },
  {
   "id": 5700,
   "offset": 4361168,
   "text": "떨잤\n간건뚜쟤몬묶\n낱낳。\n깊캬끔깊\n뚝잠녀녁。",
   "unknown": 0,
   "hangul": 18
  },
  {
   "id": 5701,
   "offset": 4361228,
   "text": "떨잤그적\n께빡갯\n낱낳。\n곽낙몬전절\n갚네。",
   "unknown": 0,
   "hangul": 16
  },
  {
   "id": 5702,
   "offset": 4361288,
   "text": "떨잤\n훨묶\n낱낳。\n곽낙낱낳\n갚네。",
   "unknown": 0,
   "hangul": 12
  },
  {
   "id": 5703,
   "offset": 4361348,
   "text": "젊□몬묶점\n께곽낙떨잤\n낱낳。\n갚화슴\n간끔갠갤。",
   "unknown": 1,
   "hangul": 18
  },
  {
   "id": 5704,
   "offset": 4361408,
   "text": "검월너몬\n□눔\n께곽낙\n낱낳。",
   "unknown": 1,
   "hangul": 10
  },
  {
   "id": 5705,
   "offset": 4361468,
   "text": "검월□\n뎌애몬\n읍딕롤냇\n께곽낙\n낱낳。",
   "unknown": 1,
   "hangul": 14
  },
  {
   "id": 5706,
   "offset": 4361528,
   "text": "검롤냇\n접멜겪낳빡갯\n낱낳。\n멜먼\n깊군눑육。",
   "unknown": 0,
   "hangul": 17
  },
  {
   "id": 5707,
   "offset": 4361588,
   "text": "검□\n믿겪곽낙\n낱낳。\n곽낙뎠계\n눑육뎠꼴。",
   "unknown": 1,
   "hangul": 15
  },
  {
   "id": 5708,
   "offset": 4361648,
   "text": "빡갯\n헌걷몬낱낳\n눑육넋□\n괘헌빡갯。",
   "unknown": 1,
   "hangul": 14
  },
  {
   "id": 5709,
   "offset": 4361708,
   "text": "□정뵐낀냈\n낱낳곽낙\n햇깊궂멜먼몬넣비\n냅괃캬\n뒈끔헌걷눑육。",
   "unknown": 1,
   "hangul": 25
  },
  {
   "id": 5710,
   "offset": 4361768,
   "text": "럭긴림롤냈너\n믿겪곽낙\n낱낳。\n깊캬끔□정\n꿈계몬딧백。",
   "unknown": 1,
   "hangul": 21
  },
  {
   "id": 5711,
   "offset": 4361828,
   "text": "뇌긱□늑\n낱낳。\n헌곽낙\n눑육몬군녹\nHP할림。",
   "unknown": 1,
   "hangul": 15
  },
  {
   "id": 5712,
   "offset": 4361888,
   "text": "뇌긱□늑\n낱낳。\n헌곽낙\n눑육몬군녹\nHP할림。",
   "unknown": 1,
   "hangul": 15
  },
  {
   "id": 5713,
   "offset": 4361948,
   "text": "교빡갯롤냇\n젖띨급낀\n렴과꼬끔뇌□곽낙몬HP\n멜먼헙헙\n할림。",
   "unknown": 1,
   "hangul": 23
  },
  {
   "id": 5714,
   "offset": 4362008,
   "text": "닐롤냇\n뎌애껼껴\n선껌멜먼몬\n독낱。",
   "unknown": 0,
   "hangul": 14
  },
  {
   "id": 5715,
   "offset": 4362068,
   "text": "검젝낀\n임잤빡갯\n낱낳。\n닥닦병문\n눈덕。",
   "unknown": 0,
   "hangul": 15
  },
  {
   "id": 5716,
   "offset": 4362128,
   "text": "낮1화슴\n긱긴묶\n□2화슴\n께빡갯\n낱낳。",
   "unknown": 1,
   "hangul": 13
  },
  {
   "id": 5717,
   "offset": 4362188,
   "text": "겔게꼴너몬\n넴펜\n닐곽낙\n꿈뻥문넴녀녁。",
   "unknown": 0,
   "hangul": 16
  },
  {
   "id": 5718,
   "offset": 4362248,
   "text": "겔게꼴너몬\n젤□펜져\n닐곽낙\n꿈뻥닛닝녀녁。",
   "unknown": 1,
   "hangul": 17
  },
  {
   "id": 5719,
   "offset": 4362308,
   "text": "겔게꼴너몬\n□닙펜\n닐곽낙\n꿈뻥님닙녀녁。",
   "unknown": 1,
   "hangul": 16
  },
  {
   "id": 5720,
   "offset": 4362368,
   "text": "2-3화슴\n뿐믄잘냈\n낱낳。\n꽥낱낳미\n넓뚝잠。",
   "unknown": 0,
   "hangul": 15
  },
  {
   "id": 5721,
   "offset": 4362428,
   "text": "고득문\n않게꼴너몬졌\n헬멱빡갯\n걸전절갚네。",
   "unknown": 0,
   "hangul": 18
  },
  {
   "id": 5722,
   "offset": 4362488,
   "text": "검□낳낼\n께곽낙\n낱낳。\n넓눑육\n40。",
   "unknown": 1,
   "hangul": 11
  },
  {
   "id": 5723,
   "offset": 4362548,
   "text": "검족박몬\n딤으\n교2-5화슴□\n□존곽낙\n낱낳。",
   "unknown": 2,
   "hangul": 14
  },
  {
   "id": 5724,
   "offset": 4362608,
   "text": "검둘솜\n께곽낙\n낱낳。\n깊캬꿈뻥\n닛닝녀녁。",
   "unknown": 0,
   "hangul": 16
  },
  {
   "id": 5725,
   "offset": 4362668,
   "text": "검넬둘솜\n께곽낙\n낱낳。\n깊캬꿈뻥\n닛닝녀녁。",
   "unknown": 0,
   "hangul": 17
  },
  {
   "id": 5726,
   "offset": 4362728,
   "text": "검돗둘솜\n낱낳\n곽낙깊캬꿈뻥\n닛닝녀녁。",
   "unknown": 0,
   "hangul": 16
  },
  {
   "id": 5727,
   "offset": 4362788,
   "text": "쇄박몬뒙둘\n께곽낙\n낱낳。\n깊캬꿈뻥\n닛닝녀녁。",
   "unknown": 0,
   "hangul": 18
  },
  {
   "id": 5728,
   "offset": 4362848,
   "text": "□게\n군숙딧\n께곽낙\n낱낳。",
   "unknown": 1,
   "hangul": 9
  },
  {
   "id": 5729,
   "offset": 4362908,
   "text": "께넌널문\n멜먼걷말몬\n다당\n떨게덤졸\n낱낳。",
   "unknown": 0,
   "hangul": 17
  },
  {
   "id": 5730,
   "offset": 4362968,
   "text": "원논덤뻔\n께곽낙\n낱낳。\n곽빡갯\n깊꼴눑육。",
   "unknown": 0,
   "hangul": 16
  },
  {
   "id": 5731,
   "offset": 4363028,
   "text": "1화슴\n좀띨덤갚\n갚콘화슴낱낳。\n끔고덤갚\n맡딛게꽈。",
   "unknown": 0,
   "hangul": 20
  },
  {
   "id": 5732,
   "offset": 4363088,
   "text": "걸곽낙\n꿈뻥문넴녀녁。\n렴화슴\n넴눑육\n넘넬。",
   "unknown": 0,
   "hangul": 17
  },
  {
   "id": 5733,
   "offset": 4363148,
   "text": "검돗몬좁냈\n께곽낙\n낱낳。\n깊캬꿈뻥\n뚝잠녀녁。",
   "unknown": 0,
   "hangul": 18
  },
  {
   "id": 5734,
   "offset": 4363208,
   "text": "검넬몬좁냈\n께곽낙\n낱낳。\n곽낙몬독잣\n갚네。",
   "unknown": 0,
   "hangul": 17
  },
  {
   "id": 5735,
   "offset": 4363268,
   "text": "곽빡갯\n검□종\n걸빡갯\n님닙。",
   "unknown": 1,
   "hangul": 10
  },
  {
   "id": 5736,
   "offset": 4363328,
   "text": "떨게\n님닙냈너\n멜먼\n낱낳끔냈\n선껌。",
   "unknown": 0,
   "hangul": 14
  },
  {
   "id": 5737,
   "offset": 4363388,
   "text": "늘냈너\n좋□롤냇\n껌애갠갤\n멜먼몬전절\n선껌。",
   "unknown": 1,
   "hangul": 17
  },
  {
   "id": 5738,
   "offset": 4363448,
   "text": "검□갯몬\n애빙\n낱낳곽낙\n깠군것관\n빈댕몬낱낳。",
   "unknown": 1,
   "hangul": 18
  },
  {
   "id": 5739,
   "offset": 4363508,
   "text": "좌공곽낙몬\n낱낳캬\n떨□\n멜먼몬욱끔\n걱선껌。",
   "unknown": 1,
   "hangul": 17
  },
  {
   "id": 5740,
   "offset": 4363568,
   "text": "동견궂권꺽다당\n넌널。\n끔뒤뎌공낵\n깊다당문개몬\n엠장。",
   "unknown": 0,
   "hangul": 22
  },
  {
   "id": 5741,
   "offset": 4363628,
   "text": "건뜀□조\n닐곽낙겉공\n딴딸관궂멜먼몬넣비\n냅괃캬\n뒈끔헌걷눑육。",
   "unknown": 1,
   "hangul": 26
  },
  {
   "id": 5742,
   "offset": 4363688,
   "text": "곽낙\n걸검몬욱끔\n교넌널문\n끔학껼\n멜먼몬욱끔。",
   "unknown": 0,
   "hangul": 19
  },
  {
   "id": 5743,
   "offset": 4363748,
   "text": "떨게표땀\n걸빡갯\n잣□\n닻족\n갚네。",
   "unknown": 1,
   "hangul": 12
  },
  {
   "id": 5744,
   "offset": 4363808,
   "text": "늑롤\n낱낳빡갯\n멜먼몬\n화동묻선껌。",
   "unknown": 0,
   "hangul": 14
  },
  {
   "id": 5745,
   "offset": 4363868,
   "text": "멜먼녔눅\n멜먼몬HP\n할림꼭\n몹꼴HP몬\n군녹。",
   "unknown": 0,
   "hangul": 15
  },
  {
   "id": 5746,
   "offset": 4363928,
   "text": "림롤\n럭긴냈너\n학□\n잣□선껌。",
   "unknown": 2,
   "hangul": 10
  },
  {
   "id": 5747,
   "offset": 4363988,
   "text": "림롤\n학군\n멜먼몬\n화동묻선껌。",
   "unknown": 0,
   "hangul": 12
  },
  {
   "id": 5748,
   "offset": 4364048,
   "text": "겔게죽\n닐많존\n겉간문\n걸곽낙몬\n병문갚네。",
   "unknown": 0,
   "hangul": 17
  },
  {
   "id": 5749,
   "offset": 4364108,
   "text": "검건파묶\n버□곽낙\n낱낳\n닐곽낙꿈뻥\n뚝잠녀녁。",
   "unknown": 1,
   "hangul": 18
  },
  {
   "id": 5750,
   "offset": 4364168,
   "text": "롤냇좀띨\n□람환\n멜먼몬\n잣□선껌。",
   "unknown": 2,
   "hangul": 12
  },
  {
   "id": 5751,
   "offset": 4364228,
   "text": "원논롤냇\n뽀□눈덕\n멜먼몬\n잣□선껌。",
   "unknown": 2,
   "hangul": 13
  },
  {
   "id": 5752,
   "offset": 4364288,
   "text": "교□낮\n괅뜻게\n렁꿇몬줄줌\n멜먼몬잣□\n깊꼴선껌。",
   "unknown": 2,
   "hangul": 18
  },
  {
   "id": 5753,
   "offset": 4364348,
   "text": "5화슴\n괅뜻\n묶줌\n□맸독낱몬\n눑육。",
   "unknown": 1,
   "hangul": 12
  },
  {
   "id": 5754,
   "offset": 4364408,
   "text": "넌널문\n겔게몸멀죽줍\n다당\n림냇\n끔냈림뵐。",
   "unknown": 0,
   "hangul": 17
  },
  {
   "id": 5755,
   "offset": 4364468,
   "text": "5화슴\n괅뜻묶줌\n빡갯몬\n낱낳\n눑육□맸。",
   "unknown": 1,
   "hangul": 14
  },
  {
   "id": 5756,
   "offset": 4364528,
   "text": "음닿뚜냈\n낱낳\n멜먼몬낱낳\n닥닦병문\n눈덕。",
   "unknown": 0,
   "hangul": 17
  },
  {
   "id": 5757,
   "offset": 4364588,
   "text": "2화슴\n좌공몬눑육\n넋□\n괘화。",
   "unknown": 1,
   "hangul": 10
  },
  {
   "id": 5758,
   "offset": 4364648,
   "text": "심갤낙발\n고느깊몬\n욱끔문\n떨게\n핸때몬1콘。",
   "unknown": 0,
   "hangul": 17
  },
  {
   "id": 5759,
   "offset": 4364708,
   "text": "먐□곽낙\n걸검몬욱끔\n멜먼\n걱끔걸검냅괃몬욱끔。",
   "unknown": 1,
   "hangul": 19
  },
  {
   "id": 5760,
   "offset": 4364768,
   "text": "곽빡갯\n깊꼴눑육몬\n낱낳。\n꽥걸검미\n간끔넌널。",
   "unknown": 0,
   "hangul": 18
  },
  {
   "id": 5761,
   "offset": 4364828,
   "text": "검꼴□\n휨휨몬\n겪낳곽낙\n낱낳。",
   "unknown": 1,
   "hangul": 11
  },
  {
   "id": 5762,
   "offset": 4364888,
   "text": "검껴중백\n□곽낙\n낱낳。\n깊캬꿈뻥\n닛닝녀녁。",
   "unknown": 1,
   "hangul": 16
  },
  {
   "id": 5763,
   "offset": 4364948,
   "text": "검넴뚜\n께곽낙\n낱낳。\n깊캬꿈뻥\n문넴녀녁。",
   "unknown": 0,
   "hangul": 16
  },
  {
   "id": 5764,
   "offset": 4365008,
   "text": "검넴뚜\n께곽낙\n낱낳。\n깊캬꿈뻥\n님닙녀녁。",
   "unknown": 0,
   "hangul": 16
  },
  {
   "id": 5765,
   "offset": 4365068,
   "text": "검다백\n께곽낙\n낱낳。\n깊캬꿈뻥\n□련녀녁。",
   "unknown": 1,
   "hangul": 15
  },
  {
   "id": 5766,
   "offset": 4365128,
   "text": "□□딤으\n께곽낙떨잤\n낱낳。\n깊캬꿈뻥\n□육녀녁。",
   "unknown": 3,
   "hangul": 16
  },
  {
   "id": 5767,
   "offset": 4365188,
   "text": "검더덕몬뚜냈\n께곽낙\n낱낳。\n끔즉엉공\n□되몬같든。",
   "unknown": 1,
   "hangul": 19
  },
  {
   "id": 5768,
   "offset": 4365248,
   "text": "검꿈렁꿇몬\n활람\n2-5화슴\n음낳곽낙\n함갔낱낳。",
   "unknown": 0,
   "hangul": 17
  },
  {
   "id": 5769,
   "offset": 4365308,
   "text": "떨잤묶점\n께곽낙\n낱낳。\n낱낳\n군것병문。",
   "unknown": 0,
   "hangul": 15
  },
  {
   "id": 5770,
   "offset": 4365368,
   "text": "□1화슴\n원논둠□\n□2화슴낱낳。\n□1화슴\n멜먼몬잣□같넥。",
   "unknown": 5,
   "hangul": 17
  },
  {
   "id": 5771,
   "offset": 4365428,
   "text": "떨잤\n을너몬장\n낱낳。\n2-5화슴육믄\n헌걷눑육。",
   "unknown": 0,
   "hangul": 16
  },
  {
   "id": 5772,
   "offset": 4365488,
   "text": "헬멱빡갯\n함갔\n낱낳。\n곽낙몬전절\n갚네。",
   "unknown": 0,
   "hangul": 15
  },
  {
   "id": 5773,
   "offset": 4365548,
   "text": "군캬럴\n□□많존몬\n군를납긋\n멜먼몬독잣\n즐애선껌。",
   "unknown": 2,
   "hangul": 19
  },
  {
   "id": 5774,
   "offset": 4365608,
   "text": "굘갤\n멜먼낙문몬\n즘낀\n걸곽낙몬\n병문갚네。",
   "unknown": 0,
   "hangul": 17
  },
  {
   "id": 5775,
   "offset": 4365668,
   "text": "냇냈할림꼭\n몹꼴HP몬\n군녹。\nHP걱끔\n늑헌낌낑。",
   "unknown": 0,
   "hangul": 16
  },
  {
   "id": 5776,
   "offset": 4365728,
   "text": "□즙\n믿겪빡갯\n낱낳。\n믿간문\n멜먼눑육。",
   "unknown": 1,
   "hangul": 14
  },
  {
   "id": 5777,
   "offset": 4365788,
   "text": "버□빡갯\n걸빡갯\n꿈뻥\n닛닝녀녁。",
   "unknown": 1,
   "hangul": 12
  },
  {
   "id": 5778,
   "offset": 4365848,
   "text": "낱낳\n님닙녀녁문몬\n곽낙\nHP할림\n눑육몬군녹。",
   "unknown": 0,
   "hangul": 17
  },
  {
   "id": 5779,
   "offset": 4365908,
   "text": "걸검\n깊넴뚜냇\n닐곽낙\n꿈뻥문넴녀녁。",
   "unknown": 0,
   "hangul": 15
  },
  {
   "id": 5780,
   "offset": 4365968,
   "text": "늬긋냇\n께곽낙\n낱낳。\n2-5화슴육믄\n헌걷눑육。",
   "unknown": 0,
   "hangul": 16
  },
  {
   "id": 5781,
   "offset": 4366028,
   "text": "뇌땀\n낱낳。\nHP할림\n관헌곽낙\n눑육몬군녹。",
   "unknown": 0,
   "hangul": 15
  },
  {
   "id": 5782,
   "offset": 4366088,
   "text": "걸검\n건뜀몬□증\n닐곽낙꿈뻥\n님닙녀녁。",
   "unknown": 1,
   "hangul": 15
  },
  {
   "id": 5783,
   "offset": 4366148,
   "text": "□2화슴\n낱낳곽낙。\n깊캬넓련\n닥닦병문\n눈덕。",
   "unknown": 1,
   "hangul": 16
  },
  {
   "id": 5784,
   "offset": 4366208,
   "text": "끔학껼\n궂빡갯다당\n냅괃몬먐픕\n□끔걸검\n냅괃몬욱끔。",
   "unknown": 1,
   "hangul": 21
  },
  {
   "id": 5785,
   "offset": 4366268,
   "text": "떨게\n꼴너그적\n낱낳。\n곽낙몬전절\n갚네。",
   "unknown": 0,
   "hangul": 15
  },
  {
   "id": 5786,
   "offset": 4366328,
   "text": "검헴낀\n께곽낙\n낱낳。\n깊캬꿈뻥\n뚝잠녀녁。",
   "unknown": 0,
   "hangul": 16
  },
  {
   "id": 5787,
   "offset": 4366388,
   "text": "떨게\n님닙냈너\n깊캬\n걸곽낙꿈뻥\n님닙녀녁。",
   "unknown": 0,
   "hangul": 17
  },
  {
   "id": 5788,
   "offset": 4366448,
   "text": "떨게넬묶\n걸빡갯병문갚네。\n교□몬궐궤문\n걸검몬겊\n끔□여많존。",
   "unknown": 2,
   "hangul": 24
  },
  {
   "id": 5789,
   "offset": 4366508,
   "text": "검딨다낼\n께곽낙떨잤\n낱낳。\n렴과걸검\n눑육깊학델。",
   "unknown": 0,
   "hangul": 20
  },
  {
   "id": 5790,
   "offset": 4366568,
   "text": "간끔낱낳\n햇관교깐콘댕슴\n끔□논꽈\n던깊낚헉검。",
   "unknown": 1,
   "hangul": 19
  },
  {
   "id": 5791,
   "offset": 4366628,
   "text": "□직군픕몬\n롤냇\n학껼주냇\n멜먼몬잣□\n즐애선껌。",
   "unknown": 2,
   "hangul": 18
  },
  {
   "id": 5792,
   "offset": 4366688,
   "text": "검꼴헴\n께곽낙\n낱낳。\n닥닦병문\n눈덕。",
   "unknown": 0,
   "hangul": 14
  },
  {
   "id": 5793,
   "offset": 4366748,
   "text": "곽빡갯\n깊꼴눑육몬\n낱낳。\n꽥걸검미\n간끔넌널。",
   "unknown": 0,
   "hangul": 18
  },
  {
   "id": 5794,
   "offset": 4366808,
   "text": "검을너몬\n발랄\n낱낳。\n2-5화슴육믄\n헌걷눑육。",
   "unknown": 0,
   "hangul": 16
  },
  {
   "id": 5795,
   "offset": 4366868,
   "text": "늬다백\n께곽낙\n육믄\n2화슴\n낱낳。",
   "unknown": 0,
   "hangul": 12
  },
  {
   "id": 5796,
   "offset": 4366928,
   "text": "2화슴\n님닙몇눔\n멜먼몬HP\n궂녀녁년녈\n꼬할림。",
   "unknown": 0,
   "hangul": 17
  },
  {
   "id": 5797,
   "offset": 4366988,
   "text": "늬꼴몬숙딧\n께빡갯\n낱낳。\n빡갯깊캬\n넓련。",
   "unknown": 0,
   "hangul": 16
  },
  {
   "id": 5798,
   "offset": 4367048,
   "text": "검을너몬낮□\n질압\n함갔낱낳。\n곽낙깊캬\n넓련몬。",
   "unknown": 1,
   "hangul": 18
  },
  {
   "id": 5799,
   "offset": 4367108,
   "text": "롤냇\n학껼□덤룰\n멜먼몬\n낱낳선껌。",
   "unknown": 1,
   "hangul": 13
  },
  {
   "id": 5800,
   "offset": 4367168,
   "text": "늘멜먼몬\n욱끔\n럽학껼놉놋\n냅괃몬\n놉놋。",
   "unknown": 0,
   "hangul": 16
  },
  {
   "id": 5801,
   "offset": 4367228,
   "text": "3급묶점\n군논낱낳。\n닛닝□육\n서켓녀녁\n꼬건끔게곧。",
   "unknown": 1,
   "hangul": 19
  },
  {
   "id": 5802,
   "offset": 4367288,
   "text": "검을너몬낮□\n질압\n낱낳。\n곽낙몬HP\n학껼군녹。",
   "unknown": 1,
   "hangul": 16
  },
  {
   "id": 5803,
   "offset": 4367348,
   "text": "검을너몬발랄넣\n께곽낙\n낱낳。\n닥닦병문\n눈덕。",
   "unknown": 0,
   "hangul": 18
  },
  {
   "id": 5804,
   "offset": 4367408,
   "text": "멜먼몬HP\n간깨겹꾸력\n걸검。\n늑롤\n멜먼건걷작동。",
   "unknown": 0,
   "hangul": 18
  },
  {
   "id": 5805,
   "offset": 4367468,
   "text": "PP던깊캬\n건걸검\n낱낳곽낙。\n멜먼\n걱깊눑육。",
   "unknown": 0,
   "hangul": 16
  },
  {
   "id": 5806,
   "offset": 4367528,
   "text": "빡갯걸검몬욱끔\n학껼멜먼몬\n욱끔。\n1화슴낡걸검몬겊\n룩간끔먐□。",
   "unknown": 1,
   "hangul": 25
  },
  {
   "id": 5807,
   "offset": 4367588,
   "text": "3화슴육믄\n함갔\n낱낳。\n렴과병문\n눑육넘넋。",
   "unknown": 0,
   "hangul": 16
  },
  {
   "id": 5808,
   "offset": 4367648,
   "text": "낱낳캬\n빨벌번□젤짐。\n멜먼뚱꺼\n깊몬겹겼\n간끔번□。",
   "unknown": 2,
   "hangul": 19
  },
  {
   "id": 5809,
   "offset": 4367708,
   "text": "검졌점\n헬멱빡갯\n걸빡갯\n간끔두보\n넌널。",
   "unknown": 0,
   "hangul": 16
  },
  {
   "id": 5810,
   "offset": 4367768,
   "text": "□멱빡갯\n갠갤덥께\n갚콘화슴\n군것병문\n빡갯。",
   "unknown": 1,
   "hangul": 17
  },
  {
   "id": 5811,
   "offset": 4367828,
   "text": "곽님닙녀녁몬\n곽낙\n렴화슴\nHP\n□□갚네。",
   "unknown": 2,
   "hangul": 13
  },
  {
   "id": 5812,
   "offset": 4367888,
   "text": "겔게딤으\n맡함곽낙\n낱낳。\n깊캬꿈뻥\n□육녀녁。",
   "unknown": 1,
   "hangul": 17
  },
  {
   "id": 5813,
   "offset": 4367948,
   "text": "걸검\n곽낙깊캬\n넓련。\n꽥햇끔교멜먼\n햇끔교님닙캬걸검。",
   "unknown": 0,
   "hangul": 22
  },
  {
   "id": 5814,
   "offset": 4368008,
   "text": "걸검몬다당\n몹꽁관법껄놉놋\n꿀둬몬겊\n욱끔눈록\n림딛간괃。",
   "unknown": 0,
   "hangul": 24
  },
  {
   "id": 5815,
   "offset": 4368068,
   "text": "쇄박몬\n낱낳。\n멜먼몬HP\n뎠군\n눑육뎠꼴。",
   "unknown": 0,
   "hangul": 14
  },
  {
   "id": 5816,
   "offset": 4368128,
   "text": "곽낙\n걸검몬욱끔\n간괃\n멜먼몬\n놉놋걱럽학。",
   "unknown": 0,
   "hangul": 17
  },
  {
   "id": 5817,
   "offset": 4368188,
   "text": "렉맍낼\n께곽낙떨잤\n낱낳。\n닥닦병문\n눈덕。",
   "unknown": 0,
   "hangul": 16
  },
  {
   "id": 5818,
   "offset": 4368248,
   "text": "원논넬렘\n걸빡갯\n전절\n닻족\n갚네。",
   "unknown": 0,
   "hangul": 13
  },
  {
   "id": 5819,
   "offset": 4368308,
   "text": "깊냈너몬\n낱낳。\n멜먼몬HP\n뎠군\n눑육뎠꼴。",
   "unknown": 0,
   "hangul": 15
  },
  {
   "id": 5820,
   "offset": 4368368,
   "text": "□멱곽낙\n몹미걸검몬\n욱끔\n격욱끔몬PP\n갚네2-5。",
   "unknown": 1,
   "hangul": 16
  },
  {
   "id": 5821,
   "offset": 4368428,
   "text": "□낑꿋렘\n께곽낙\n낱낳。\n깊캬꿈뻥\n서켓녀녁。",
   "unknown": 1,
   "hangul": 16
  },
  {
   "id": 5822,
   "offset": 4368488,
   "text": "합낮걸검몬욱끔\n냉록간끔\n병문곽낙。\n육믄낱낳\n걱닥닦뜨뜨。",
   "unknown": 0,
   "hangul": 24
  },
  {
   "id": 5823,
   "offset": 4368548,
   "text": "검더덕몬\n꼴헴낀\n뎌애낱낳\n군것관빈댕몬\n낱낳덥쁜。",
   "unknown": 0,
   "hangul": 21
  },
  {
   "id": 5824,
   "offset": 4368608,
   "text": "검□증\n걸빡갯덕뜀\n곽낙몬\n전절\n닻족갚네。",
   "unknown": 1,
   "hangul": 16
  },
  {
   "id": 5825,
   "offset": 4368668,
   "text": "밟못빡갯\n떨갤\n낱낳。\n낱낳군것\n병문。",
   "unknown": 0,
   "hangul": 14
  },
  {
   "id": 5826,
   "offset": 4368728,
   "text": "검□증\n걸빡갯\n꿈뻥\n뚝잠녀녁。",
   "unknown": 1,
   "hangul": 11
  },
  {
   "id": 5827,
   "offset": 4368788,
   "text": "멜먼몬HP\n갚네꼭몹꼴HP몬\n군녹캬\n멜먼몬낱낳\n선껌공몹꼴。",
   "unknown": 0,
   "hangul": 22
  },
  {
   "id": 5828,
   "offset": 4368848,
   "text": "검□웃\n께곽낙\n낱낳。\n깊캬꿈뻥\n넴녀녁。",
   "unknown": 1,
   "hangul": 14
  },
  {
   "id": 5829,
   "offset": 4368908,
   "text": "궜□\n늬공빡갯먼같\n낱낳。\n곽낙몬\n병문갚네。",
   "unknown": 1,
   "hangul": 16
  },
  {
   "id": 5830,
   "offset": 4368968,
   "text": "궜□\n늬공빡갯먼같\n낱낳。\n곽낙몬병문\n갚네。",
   "unknown": 1,
   "hangul": 16
  },
  {
   "id": 5831,
   "offset": 4369028,
   "text": "헬멱\n빡갯몬□\n낱낳\n곽모□다당\n헌걷눑육。",
   "unknown": 2,
   "hangul": 15
  },
  {
   "id": 5832,
   "offset": 4369088,
   "text": "떨잤\n넬둘\n낱낳。\n곽낙넓꿈뻥닛닝\n녀녁。",
   "unknown": 0,
   "hangul": 15
  },
  {
   "id": 5833,
   "offset": 4369148,
   "text": "화동묻같넥\n간닥닦\n걸검욱끔\n곽낙몬화동묻\n림뵐。",
   "unknown": 0,
   "hangul": 20
  },
  {
   "id": 5834,
   "offset": 4369208,
   "text": "욱끔\n걸검미\n빡꽉잊덥\n군논\n좌육。",
   "unknown": 0,
   "hangul": 13
  },
  {
   "id": 5835,
   "offset": 4369268,
   "text": "다당\n3화슴\n꼬좌육。\n경곁몬겊\n뜨궁눈록。",
   "unknown": 0,
   "hangul": 15
  },
  {
   "id": 5836,
   "offset": 4369328,
   "text": "검팟뚜\n께곽낙\n낱낳。\n괃캬곽낙몬\n전절갚네。",
   "unknown": 0,
   "hangul": 17
  },
  {
   "id": 5837,
   "offset": 4369388,
   "text": "걸검뺀뒈몬욱끔\n간끔동견\n곽낙몬낱낳。\n육믄걸검\n닥닦뜨뜨。",
   "unknown": 0,
   "hangul": 24
  },
  {
   "id": 5838,
   "offset": 4369448,
   "text": "검낙문몬다백\n께곽낙\n낱낳。\n2-5화슴육믄\n헌걷눑육。",
   "unknown": 0,
   "hangul": 19
  },
  {
   "id": 5839,
   "offset": 4369508,
   "text": "존멱\n빡갯\n갚콘낱낳\n군것\n병문。",
   "unknown": 0,
   "hangul": 12
  },
  {
   "id": 5840,
   "offset": 4369568,
   "text": "2-3화슴\n뿐믄넬박\n낱낳。\n낱낳미\n넓뚝잠。",
   "unknown": 0,
   "hangul": 14
  },
  {
   "id": 5841,
   "offset": 4369628,
   "text": "5화슴\n떨게□잘\n곽덤든□놉놋\n걷말몬다당\n헌걷눑육。",
   "unknown": 2,
   "hangul": 19
  },
  {
   "id": 5842,
   "offset": 4369688,
   "text": "뇌긱□□\n낱낳。\nHP할림꼭\n헌곽낙눑육몬\n군녹。",
   "unknown": 2,
   "hangul": 15
  },
  {
   "id": 5843,
   "offset": 4369748,
   "text": "낄걸좌공낱낳\nHP걱군것\n괘깊1。\n육믄걸검몬겊\n닥닦뜨뜨。",
   "unknown": 0,
   "hangul": 21
  },
  {
   "id": 5844,
   "offset": 4369808,
   "text": "버□\n빡갯\n걸곽낙몬\n낱낳냈\n닻족갚네。",
   "unknown": 1,
   "hangul": 14
  },
  {
   "id": 5845,
   "offset": 4369868,
   "text": "5화슴\n께곽낙\n낱낳。\n렴과병문\n눑육꼬넘넋。",
   "unknown": 0,
   "hangul": 16
  },
  {
   "id": 5846,
   "offset": 4369928,
   "text": "곽낙HP\n군것괘깊1\n뽀향\n군늑냇냈\n낱낳。",
   "unknown": 0,
   "hangul": 14
  },
  {
   "id": 5847,
   "offset": 4369988,
   "text": "닐빡갯\n꿈뻥\n뚝잠녀녁\n낱낳즐애\n같넥。",
   "unknown": 0,
   "hangul": 15
  },
  {
   "id": 5848,
   "offset": 4370048,
   "text": "HP할림꼭\n몹꼴HP몬\n군녹。\nHP걱건걷\n늑헌낌낑。",
   "unknown": 0,
   "hangul": 15
  },
  {
   "id": 5849,
   "offset": 4370108,
   "text": "긴문둘솜\n께곽낙맡함\n낱낳。\n깊캬꿈뻥\n닛닝녀녁。",
   "unknown": 0,
   "hangul": 19
  },
  {
   "id": 5850,
   "offset": 4370168,
   "text": "검발랄넣\n께곽낙\n낱낳。\n육믄병문\n눑육넘넋。",
   "unknown": 0,
   "hangul": 17
  },
  {
   "id": 5851,
   "offset": 4370228,
   "text": "랠견힘□\n께곽낙\n낱낳。\n멜먼몬잣□\n깊캬같넥。",
   "unknown": 2,
   "hangul": 16
  },
  {
   "id": 5852,
   "offset": 4370288,
   "text": "검몸멀몬\n걔묶\n겉빡갯\n늘빡갯고넌널문\n듭댐。",
   "unknown": 0,
   "hangul": 18
  },
  {
   "id": 5853,
   "offset": 4370348,
   "text": "보흩\n간괃\n꿈과걸검。\n곽낙걱과걷\n걸검욱끔。",
   "unknown": 0,
   "hangul": 17
  },
  {
   "id": 5854,
   "offset": 4370408,
   "text": "멜먼\n깨겹몬욱끔\n끔걸검1콘。\n햇끔교멜먼\n님닙캬걸검。",
   "unknown": 0,
   "hangul": 21
  },
  {
   "id": 5855,
   "offset": 4370468,
   "text": "끔떨게\n갤딥몬땀멀\n괃낑림□\n녀녁년녈\n할림。",
   "unknown": 1,
   "hangul": 17
  },
  {
   "id": 5856,
   "offset": 4370528,
   "text": "뜻꼭댑대댕\n께곽낙림냈\n낱낳。\n눑육\n꿈꼴。",
   "unknown": 0,
   "hangul": 16
  },
  {
   "id": 5857,
   "offset": 4370588,
   "text": "께곽낙\n늬름려\n낱낳。\n깊캬넓닐곽덥\nHP할림。",
   "unknown": 0,
   "hangul": 16
  },
  {
   "id": 5858,
   "offset": 4370648,
   "text": "개접간□\n께곽낙림냈\n함갔낱낳。\n눑육\n넓꿈꼴。",
   "unknown": 1,
   "hangul": 17
  },
  {
   "id": 5859,
   "offset": 4370708,
   "text": "5화슴\n괃낑\n밟좌승딨냈너뽀□\n간넓게곧\n녀녁년녈。",
   "unknown": 1,
   "hangul": 19
  },
  {
   "id": 5860,
   "offset": 4370768,
   "text": "멜먼몬HP\n궂곽낙몬HP\n경곁\n멜먼궂곽낙\n끔껼꼭답머。",
   "unknown": 0,
   "hangul": 19
  },
  {
   "id": 5861,
   "offset": 4370828,
   "text": "검승똑딤으\n께곽낙\n낱낳。\n깊캬꿈뻥\n□육녀녁。",
   "unknown": 1,
   "hangul": 17
  },
  {
   "id": 5862,
   "offset": 4370888,
   "text": "짓갤꼴덤\n께빡갯\n낱낳。\n눑육\n깊금급금픕。",
   "unknown": 0,
   "hangul": 16
  },
  {
   "id": 5863,
   "offset": 4370948,
   "text": "긴문림롤몬냈너\n검헴낀\n낱낳。\n닐곽낙꿈뻥뚝잠\n녀녁。",
   "unknown": 0,
   "hangul": 21
  },
  {
   "id": 5864,
   "offset": 4371008,
   "text": "검밉□몬덤\n께빡갯\n떨갤\n낱낳。",
   "unknown": 1,
   "hangul": 11
  },
  {
   "id": 5865,
   "offset": 4371068,
   "text": "떨게더덕몬뚜냈\n께곽낙\n낱낳。\n깊캬꿈뻥\n닛닝녀녁。",
   "unknown": 0,
   "hangul": 20
  },
  {
   "id": 5866,
   "offset": 4371128,
   "text": "른꿋멜먼끔냈몬\n학델\n끔럽학\n멜먼몬다당。",
   "unknown": 0,
   "hangul": 17
  },
  {
   "id": 5867,
   "offset": 4371188,
   "text": "곽낙몹미\n걸검몬욱끔\n2-6화슴\n꼬끔걸검。",
   "unknown": 0,
   "hangul": 15
  },
  {
   "id": 5868,
   "offset": 4371248,
   "text": "교곽낙\n경곁다당캬\n걸검몬겊\n헌곽낙\n깊꼴몬눑육。",
   "unknown": 0,
   "hangul": 20
  },
  {
   "id": 5869,
   "offset": 4371308,
   "text": "뎌애몬\n딕갤롤냇\n끔고□조넣\n육믄욱끔문\n두□。",
   "unknown": 2,
   "hangul": 17
  },
  {
   "id": 5870,
   "offset": 4371368,
   "text": "떨게짖□\n화동묻갚네。\n깊권꺽다당\n꺽꿉몬덤덥걸검\n다당끔게꽈。",
   "unknown": 1,
   "hangul": 25
  },
  {
   "id": 5871,
   "offset": 4371428,
   "text": "검밉□몬위눔\n께빡갯\n낱낳。\n곽낙몬잣□\n갚네。",
   "unknown": 2,
   "hangul": 16
  },
  {
   "id": 5872,
   "offset": 4371488,
   "text": "검발랄\n짚를곽낙\n낱낳。\n멜먼몬낱낳\n같넥。",
   "unknown": 0,
   "hangul": 16
  },
  {
   "id": 5873,
   "offset": 4371548,
   "text": "교곽낙\n포미몬낱낳。\n꽥멜먼몬\n낱낳군것\n병문。",
   "unknown": 0,
   "hangul": 18
  },
  {
   "id": 5874,
   "offset": 4371608,
   "text": "멜먼몬HP\n할림。\n례뚜간괃\n할림몬너\n걱깊학델。",
   "unknown": 0,
   "hangul": 17
  },
  {
   "id": 5875,
   "offset": 4371668,
   "text": "멜먼몬HP\n할림。\n례뚜간괃\n할림몬너\n걱깊학델。",
   "unknown": 0,
   "hangul": 17
  },
  {
   "id": 5876,
   "offset": 4371728,
   "text": "멜먼몬HP\n할림。\n례뚜간괃\n할림몬너\n걱깊학델。",
   "unknown": 0,
   "hangul": 17
  },
  {
   "id": 5877,
   "offset": 4371788,
   "text": "걸검욱끔몬\n다당간괃\n헌곽낙몬\n눑육궂욱끔몬\n놉놋깊학델。",
   "unknown": 0,
   "hangul": 24
  },
  {
   "id": 5878,
   "offset": 4371848,
   "text": "검잊낙\n께곽낙\n낱낳。\n닥닦병문\n눈덕。",
   "unknown": 0,
   "hangul": 14
  },
  {
   "id": 5879,
   "offset": 4371908,
   "text": "원논\n더덕몬렘\n낱낳。\n곽낙깊캬\n넓련。",
   "unknown": 0,
   "hangul": 14
  },
  {
   "id": 5880,
   "offset": 4371968,
   "text": "5화슴\n갚짜\n곽놈놉놋\n욱끔몬눑육\n꿈꼴。",
   "unknown": 0,
   "hangul": 15
  },
  {
   "id": 5881,
   "offset": 4372028,
   "text": "5화슴\n겔딤\n곽딤으놉놋\n욱끔몬눑육\n꿈꼴。",
   "unknown": 0,
   "hangul": 16
  },
  {
   "id": 5882,
   "offset": 4372088,
   "text": "검을너몬껴□\n휨휨몬질압\n낱낳。\n곽낙몬독잣\n갚네。",
   "unknown": 1,
   "hangul": 19
  },
  {
   "id": 5883,
   "offset": 4372148,
   "text": "고빡갯깐환\n좌공몬눑육\n넓넋□\n괘헌빡갯。",
   "unknown": 1,
   "hangul": 16
  },
  {
   "id": 5884,
   "offset": 4372208,
   "text": "멜먼\n번번몬\n□멱곽낙\n걸검몬욱끔\n학껼멜먼몬욱끔。",
   "unknown": 1,
   "hangul": 20
  },
  {
   "id": 5885,
   "offset": 4372268,
   "text": "뎌애\n갠갤\n맡함곽낙\n군것관빈댕몬\n낱낳。",
   "unknown": 0,
   "hangul": 16
  },
  {
   "id": 5886,
   "offset": 4372328,
   "text": "걸검뵐낀냈너\n낱낳。\n괃캬멜먼몬\n림□끔냈\n같넥。",
   "unknown": 1,
   "hangul": 18
  },
  {
   "id": 5887,
   "offset": 4372388,
   "text": "늬더덩\n곽빡갯\n낱낳。\n곽낙몬독잣\n갚네。",
   "unknown": 0,
   "hangul": 15
  },
  {
   "id": 5888,
   "offset": 4372448,
   "text": "걸검욱끔\n2화슴미\n긴문좁냈\n걱끔께곽낙\n떨갤낱낳。",
   "unknown": 0,
   "hangul": 20
  },
  {
   "id": 5889,
   "offset": 4372508,
   "text": "낱낳몬괃캬\n닐곽낙잣□\n갚네。\n끔겪뭘\n군몬숙딧。",
   "unknown": 1,
   "hangul": 18
  },
  {
   "id": 5890,
   "offset": 4372568,
   "text": "교족박몬\n놈짝문\n2-5화슴\n께곽낙\n낱낳。",
   "unknown": 0,
   "hangul": 14
  },
  {
   "id": 5891,
   "offset": 4372628,
   "text": "괃낑림□\n낱낳。\n낌낑몬다당\n뎠꾸\n눑육뎠꼴。",
   "unknown": 1,
   "hangul": 16
  },
  {
   "id": 5892,
   "offset": 4372688,
   "text": "뺀뒈걸검몬욱끔\n함갔낱낳\n곽낙넓련。\n꽥관햇끔\n□군화슴걸검。",
   "unknown": 1,
   "hangul": 24
  },
  {
   "id": 5893,
   "offset": 4372748,
   "text": "2-5화슴\n낱낳\n깠손럴\n던깊갯꿈뻥\n님닙녀녁。",
   "unknown": 0,
   "hangul": 16
  },
  {
   "id": 5894,
   "offset": 4372808,
   "text": "멜먼\n럭긴몹꼴냈너。\n몹꼴\n끔짠짤3。",
   "unknown": 0,
   "hangul": 13
  },
  {
   "id": 5895,
   "offset": 4372868,
   "text": "검럭긴몬냈너\n께곽낙\n낱낳。\n럭긴뎠꾸\n눑육뎠꼴。",
   "unknown": 0,
   "hangul": 19
  },
  {
   "id": 5896,
   "offset": 4372928,
   "text": "검럭긴몬냈너\n할림멜먼몬\nHP。\n럭긴뎠꾸\n할림뎠꼴。",
   "unknown": 0,
   "hangul": 19
  },
  {
   "id": 5897,
   "offset": 4372988,
   "text": "검쌥뚜\n곽빡갯\n낱낳。\n깊캬꿈뻥\n□육녀녁。",
   "unknown": 1,
   "hangul": 15
  },
  {
   "id": 5898,
   "offset": 4373048,
   "text": "5화슴\n떨게렘잘\n곽서켓놉놋걷말몬다당\n렴화슴\n헌걷눑육。",
   "unknown": 0,
   "hangul": 23
  },
  {
   "id": 5899,
   "offset": 4373108,
   "text": "뇌짧곽낙\n냅괃욱끔\n간끔육믄\n걸검。",
   "unknown": 0,
   "hangul": 14
  },
  {
   "id": 5900,
   "offset": 4373168,
   "text": "걸곽낙\n꿈뻥뚝잠녀녁\n괃캬\n곽낙몬\n독낱선껌。",
   "unknown": 0,
   "hangul": 18
  },
  {
   "id": 5901,
   "offset": 4373228,
   "text": "검램딤넣\n딨다몬\n딤으\n닐곽낙꿈뻥□육\n녀녁。",
   "unknown": 1,
   "hangul": 17
  },
  {
   "id": 5902,
   "offset": 4373288,
   "text": "간끔넌널\n곽낙몬\n낱낳궂독낱\n닻족갚네。",
   "unknown": 0,
   "hangul": 16
  },
  {
   "id": 5903,
   "offset": 4373348,
   "text": "멜먼넴닛닝\n□육녀녁캬\n헌곽낙몬\n눑육\n넋꼴。",
   "unknown": 1,
   "hangul": 17
  },
  {
   "id": 5904,
   "offset": 4373408,
   "text": "교곽낙\n포미몬낱낳。\n걸검욱끔포낮\n걱□끔좌공\n빡갯낱낳。",
   "unknown": 1,
   "hangul": 22
  },
  {
   "id": 5905,
   "offset": 4373468,
   "text": "곽닛닝녀녁몬\n곽낙\n헌걷꼴눑육。\n□□\n끔녔눅닛닝。",
   "unknown": 2,
   "hangul": 18
  },
  {
   "id": 5906,
   "offset": 4373528,
   "text": "뇌짧곽덥\n땋때냈\n뒤건끔\n떨심멜먼몬\n욱끔。",
   "unknown": 0,
   "hangul": 17
  },
  {
   "id": 5907,
   "offset": 4373588,
   "text": "검멜딛냈너\n낱낳。\n꽥댕슴간괃\n욱끔\n깊학델。",
   "unknown": 0,
   "hangul": 17
  },
  {
   "id": 5908,
   "offset": 4373648,
   "text": "끔럭긴\n둘냈\n둘놉놋몬\n욱끔눑육\n넋꼴。",
   "unknown": 0,
   "hangul": 15
  },
  {
   "id": 5909,
   "offset": 4373708,
   "text": "곽밟좌\n밖넌\n꿈빵째몬곽낙\n뒈끔헌짹눑육몬\n욱끔。",
   "unknown": 0,
   "hangul": 20
  },
  {
   "id": 5910,
   "offset": 4373768,
   "text": "깍떡몬곽낙\n걸검\n욱끔몬눑육\n꺅□둑\n넋꼴。",
   "unknown": 1,
   "hangul": 16
  },
  {
   "id": 5911,
   "offset": 4373828,
   "text": "능멱캬벌\n늘멜먼뿐깊몬\n겹겼궂곽낙\n뿐깊몬겹겼\n경곁。",
   "unknown": 0,
   "hangul": 22
  },
  {
   "id": 5912,
   "offset": 4373888,
   "text": "끔림괅곽낙욱끔!",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 5913,
   "offset": 4373948,
   "text": "갚군화슴\n멜먼몬HP\n할림꼭\n몹꼴HP몬군녹。",
   "unknown": 0,
   "hangul": 15
  },
  {
   "id": 5914,
   "offset": 4374008,
   "text": "검괃낌다당몬욱끔낱낳!",
   "unknown": 0,
   "hangul": 10
  },
  {
   "id": 5915,
   "offset": 4374068,
   "text": "렴화슴HP\n끔군□□할림",
   "unknown": 2,
   "hangul": 7
  },
  {
   "id": 5916,
   "offset": 4374128,
   "text": "떨심떡꼴냈너까빠꼭□명까\n끔냈갚네!",
   "unknown": 1,
   "hangul": 15
  },
  {
   "id": 5917,
   "offset": 4374188,
   "text": "걸검넴닛닝님닙\n뚝잠욱끔\n낱낳빡갯。",
   "unknown": 0,
   "hangul": 15
  },
  {
   "id": 5918,
   "offset": 4374248,
   "text": "군과\n걸검둔몬젤짐끔룩과걸검!。",
   "unknown": 0,
   "hangul": 13
  },
  {
   "id": 5919,
   "offset": 4374308,
   "text": "\n좌공눑육캬□냈같넥!",
   "unknown": 1,
   "hangul": 8
  },
  {
   "id": 5920,
   "offset": 4374368,
   "text": "검냈뒙낱낳!",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 5921,
   "offset": 4374428,
   "text": "교갚콘화슴걸곽낙님닙!",
   "unknown": 0,
   "hangul": 10
  },
  {
   "id": 5922,
   "offset": 4374488,
   "text": "걸곽낙간끔걸검젤짐!。",
   "unknown": 0,
   "hangul": 9
  },
  {
   "id": 5923,
   "offset": 4374548,
   "text": "멜먼몬HP\n꺅곽낙몬HP\n뎠군\n헌곽낙몬\n눑육뎠꼴。",
   "unknown": 0,
   "hangul": 17
  },
  {
   "id": 5924,
   "offset": 4374608,
   "text": "검놈둘\n낱낳。\nHP뎠꼴\n헌곽낙몬\n눑육뎠꼴。",
   "unknown": 0,
   "hangul": 15
  },
  {
   "id": 5925,
   "offset": 4374668,
   "text": "검믁끔냈\n럽학잊덥몬독보",
   "unknown": 0,
   "hangul": 11
  },
  {
   "id": 5926,
   "offset": 4374728,
   "text": "멜먼□쪄몬욱끔\n곽낙간끔걸검!",
   "unknown": 1,
   "hangul": 12
  },
  {
   "id": 5927,
   "offset": 4374788,
   "text": "멜먼\n넴닛닝□육\n녀녁년녈\n할림。",
   "unknown": 1,
   "hangul": 12
  },
  {
   "id": 5928,
   "offset": 4374848,
   "text": "빡갯년슭캬\n욱끔넛학껼0!",
   "unknown": 0,
   "hangul": 10
  },
  {
   "id": 5929,
   "offset": 4374908,
   "text": "유□곽낙끔걸검몬욱끔\n학껼멜먼걸검!",
   "unknown": 1,
   "hangul": 15
  },
  {
   "id": 5930,
   "offset": 4374968,
   "text": "꾸□똑룸냈너\n낱낳。\n걸검댕느간괃눈록걱간괃!",
   "unknown": 1,
   "hangul": 18
  },
  {
   "id": 5931,
   "offset": 4375028,
   "text": "1화슴\n□띨놈환\n2화슴\n낱낳。",
   "unknown": 1,
   "hangul": 9
  },
  {
   "id": 5932,
   "offset": 4375088,
   "text": "끔뿐믄2-5화슴낱낳빡갯!",
   "unknown": 0,
   "hangul": 9
  },
  {
   "id": 5933,
   "offset": 4375148,
   "text": "댕느간괃다당몬놉놋걱학델!",
   "unknown": 0,
   "hangul": 12
  },
  {
   "id": 5934,
   "offset": 4375208,
   "text": "떨게놈묶까\n독낱선껌!",
   "unknown": 0,
   "hangul": 9
  },
  {
   "id": 5935,
   "offset": 4375268,
   "text": "겔게묶낱낳\n곽낙몬독잣갚네。",
   "unknown": 0,
   "hangul": 12
  },
  {
   "id": 5936,
   "offset": 4375328,
   "text": "검쪼댈낱낳\n곽낙몬독낱갚네。",
   "unknown": 0,
   "hangul": 12
  },
  {
   "id": 5937,
   "offset": 4375388,
   "text": "눗갤쪼댈\n걸곽낙몬낱낳닻족갚네。",
   "unknown": 0,
   "hangul": 14
  },
  {
   "id": 5938,
   "offset": 4375448,
   "text": "림□다당\n꼬꿈뻥뚝잠녀녁!。",
   "unknown": 1,
   "hangul": 10
  },
  {
   "id": 5939,
   "offset": 4375508,
   "text": "닐낱낳몬곽낙\n꿈뻥□육녀녁\n닥닦낳문눈덕",
   "unknown": 1,
   "hangul": 17
  },
  {
   "id": 5940,
   "offset": 4375568,
   "text": "걸둘놉놋몬눑육갚네!",
   "unknown": 0,
   "hangul": 9
  },
  {
   "id": 5941,
   "offset": 4375628,
   "text": "5화슴\n낱낳빡갯\n눑육넘넋。",
   "unknown": 0,
   "hangul": 10
  },
  {
   "id": 5942,
   "offset": 4375688,
   "text": "검쪽낱낳\n걸빡갯님닙。",
   "unknown": 0,
   "hangul": 9
  },
  {
   "id": 5943,
   "offset": 4375748,
   "text": "멜먼몬\nHP\n할림\n군녹\n",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 5944,
   "offset": 4375808,
   "text": "걸냇냈할림군녹!",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 5945,
   "offset": 4375868,
   "text": "검을너몬□\n께곽낙낱낳。\n소□넓공떡넴녀녁",
   "unknown": 2,
   "hangul": 16
  },
  {
   "id": 5946,
   "offset": 4375928,
   "text": "검을너발랄\n□럼빡갯。\n곽낙몬잣□갚네。",
   "unknown": 2,
   "hangul": 14
  },
  {
   "id": 5947,
   "offset": 4375988,
   "text": "검젊□몬낼\n□잤곽낙。\n갚콘화슴간끔갤",
   "unknown": 2,
   "hangul": 14
  },
  {
   "id": 5948,
   "offset": 4376048,
   "text": "검놈\n낱낳곽낙。\n갚콘화슴간끔갤",
   "unknown": 0,
   "hangul": 13
  },
  {
   "id": 5949,
   "offset": 4376108,
   "text": "검껄보헴낱낳\n멜먼몬낱낳같넥。",
   "unknown": 0,
   "hangul": 13
  },
  {
   "id": 5950,
   "offset": 4376168,
   "text": "검꼴몬딤땀\n사듭빡갯\n걸빡갯님닙",
   "unknown": 0,
   "hangul": 14
  },
  {
   "id": 5951,
   "offset": 4376228,
   "text": "례뚜간괃\n헌곽낙몬눑육\n놉놋깊학델。",
   "unknown": 0,
   "hangul": 15
  },
  {
   "id": 5952,
   "offset": 4376288,
   "text": "검□뚜\n할림괃낑림□몬\n녀녁년녈。",
   "unknown": 2,
   "hangul": 12
  },
  {
   "id": 5953,
   "offset": 4376348,
   "text": "걸곽낙몬독잣\n닻족갚네。",
   "unknown": 0,
   "hangul": 10
  },
  {
   "id": 5954,
   "offset": 4376408,
   "text": "쫄논쇄박몬렘\n낱낳빡갯。\n닥닦병문。",
   "unknown": 0,
   "hangul": 14
  },
  {
   "id": 5955,
   "offset": 4376468,
   "text": "끔검멜받냈너낱낳\n꽥멜먼독낱닻족갚네。",
   "unknown": 0,
   "hangul": 17
  },
  {
   "id": 5956,
   "offset": 4376528,
   "text": "화동묻같넥\n꽥욱끔간닥닦걸게\n곽낙몬화동묻림뵐。",
   "unknown": 0,
   "hangul": 21
  },
  {
   "id": 5957,
   "offset": 4376588,
   "text": "검숙딧낱낳\n괃캬곽낙몬전절갚네。",
   "unknown": 0,
   "hangul": 14
  },
  {
   "id": 5958,
   "offset": 4376648,
   "text": "검□펜낱낳\n괃캬멜먼몬림□끔냈같넥。",
   "unknown": 2,
   "hangul": 14
  },
  {
   "id": 5959,
   "offset": 4376708,
   "text": "떨게표땀\n곽낙몬독잣닻족갚네。",
   "unknown": 0,
   "hangul": 13
  },
  {
   "id": 5960,
   "offset": 4376768,
   "text": "걸빡갯\n꿈뻥님닙녀녁。",
   "unknown": 0,
   "hangul": 9
  },
  {
   "id": 5961,
   "offset": 4376828,
   "text": "겪낳빡갯\n곽낙몬낱낳궂잣□갚네。",
   "unknown": 1,
   "hangul": 13
  },
  {
   "id": 5962,
   "offset": 4376888,
   "text": "검승똑몬냈너\n걸잣□궂독잣선껌。",
   "unknown": 1,
   "hangul": 13
  },
  {
   "id": 5963,
   "offset": 4376948,
   "text": "멜먼몬냇냈뎠꼴\n곽빡갯눑육걱꼴",
   "unknown": 0,
   "hangul": 14
  },
  {
   "id": 5964,
   "offset": 4377008,
   "text": "떨잤간건뚜쟤몬묶점\n깊캬넓꿈뻥뚝잠녀녁。",
   "unknown": 0,
   "hangul": 18
  },
  {
   "id": 5965,
   "offset": 4377068,
   "text": "걸검쫓조헴\n빡갯계곽동간견!",
   "unknown": 0,
   "hangul": 12
  },
  {
   "id": 5966,
   "offset": 4377128,
   "text": "검겉간몸몬\n승딨냈너낱낳。\n곽낙깊캬넓련。",
   "unknown": 0,
   "hangul": 17
  },
  {
   "id": 5967,
   "offset": 4377188,
   "text": "검례맍포뚜낱낳",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 5968,
   "offset": 4377248,
   "text": "검족박몬□잘\n2-5화슴낱낳곽낙。",
   "unknown": 1,
   "hangul": 11
  },
  {
   "id": 5969,
   "offset": 4377308,
   "text": "검팟뚜맡낳빡갯\n병문몬겊넓깊꼴눑육。",
   "unknown": 0,
   "hangul": 16
  },
  {
   "id": 5970,
   "offset": 4377368,
   "text": "검웃놈\n낱낳빡갯\n빡갯병문갚네。",
   "unknown": 0,
   "hangul": 13
  },
  {
   "id": 5971,
   "offset": 4377428,
   "text": "께곽낙떨잤급낀\n2-5화슴육믄\n헌걷눑육。",
   "unknown": 0,
   "hangul": 15
  },
  {
   "id": 5972,
   "offset": 4377488,
   "text": "뎌애갠갤낱낳\n갯계곽동간견!",
   "unknown": 0,
   "hangul": 12
  },
  {
   "id": 5973,
   "offset": 4377548,
   "text": "떨잤을너몬서똬\n2-5화슴육믄\n헌걷눑육。",
   "unknown": 0,
   "hangul": 15
  },
  {
   "id": 5974,
   "offset": 4377608,
   "text": "걸롤냇몬뻔든학□\n멜먼몬잣□즐애선껌。",
   "unknown": 2,
   "hangul": 15
  },
  {
   "id": 5975,
   "offset": 4377668,
   "text": "붉붐두놓\n걸빡갯간끔두댐。",
   "unknown": 0,
   "hangul": 11
  },
  {
   "id": 5976,
   "offset": 4377728,
   "text": "떨라넬몬라딤\n멜먼몬낱낳선껌。",
   "unknown": 0,
   "hangul": 13
  },
  {
   "id": 5977,
   "offset": 4377788,
   "text": "걸검을너몬발랄\n낱낳빡갯!",
   "unknown": 0,
   "hangul": 11
  },
  {
   "id": 5978,
   "offset": 4377848,
   "text": "검떡꼴몬려름겪낳빡갯\n갚콘화슴간끔갠갤!",
   "unknown": 0,
   "hangul": 18
  },
  {
   "id": 5979,
   "offset": 4377908,
   "text": "걸롤냇넬□\n멜먼몬낱낳궂잣□선껌。",
   "unknown": 2,
   "hangul": 13
  },
  {
   "id": 5980,
   "offset": 4377968,
   "text": "□1화슴눗논\n□2화슴낱낳!\n깊캬꿈뻥닛닝녀녁。",
   "unknown": 2,
   "hangul": 16
  },
  {
   "id": 5981,
   "offset": 4378028,
   "text": "늬웃□\n낱낳곽낙。\n괃캬곽낙몬전절갚네。",
   "unknown": 1,
   "hangul": 15
  },
  {
   "id": 5982,
   "offset": 4378088,
   "text": "걸낱낳몬곽낙\n꿈뻥문넴녀녁\n닥닦병문。",
   "unknown": 0,
   "hangul": 16
  },
  {
   "id": 5983,
   "offset": 4378148,
   "text": "끔혹유□\n빡갯뚱깊몬젤짐!",
   "unknown": 1,
   "hangul": 10
  },
  {
   "id": 5984,
   "offset": 4378208,
   "text": "믹낳빡갯\n멜먼걱넓깊군몬눑육!",
   "unknown": 0,
   "hangul": 13
  },
  {
   "id": 5985,
   "offset": 4378268,
   "text": "검간건뚜쟤몬젝낀낱낳빡갯!\n낱낳군것병문。",
   "unknown": 0,
   "hangul": 18
  },
  {
   "id": 5986,
   "offset": 4378328,
   "text": "걸딤으놉놋몬눑육갚네!",
   "unknown": 0,
   "hangul": 10
  },
  {
   "id": 5987,
   "offset": 4378388,
   "text": "긴문꺾승낱낳\n멜먼몬독낱궂독잣선껌。",
   "unknown": 0,
   "hangul": 16
  },
  {
   "id": 5988,
   "offset": 4378448,
   "text": "검월몬젝낀낱낳\n닥닦병문。",
   "unknown": 0,
   "hangul": 11
  },
  {
   "id": 5989,
   "offset": 4378508,
   "text": "□논승똑쭉\n멜먼몬낱낳궂전절선껌。",
   "unknown": 1,
   "hangul": 14
  },
  {
   "id": 5990,
   "offset": 4378568,
   "text": "육믄떨잤숙딧낱낳빡갯\n2-5화슴육믄헌걷눑육。",
   "unknown": 0,
   "hangul": 18
  },
  {
   "id": 5991,
   "offset": 4378628,
   "text": "뎌애둘낳\n빡갯계곽동간견!",
   "unknown": 0,
   "hangul": 11
  },
  {
   "id": 5992,
   "offset": 4378688,
   "text": "검놈□낱낳\n곽낙깊캬꿈뻥뚝잠녀녁。",
   "unknown": 1,
   "hangul": 14
  },
  {
   "id": 5993,
   "offset": 4378748,
   "text": "걸검욱끔\n2화슴미검꼴너묶점잤께빡갯。",
   "unknown": 0,
   "hangul": 16
  },
  {
   "id": 5994,
   "offset": 4378808,
   "text": "끔검멜받몬냈너낱낳\n멜먼몬독낱닻족갚네。",
   "unknown": 0,
   "hangul": 18
  },
  {
   "id": 5995,
   "offset": 4378868,
   "text": "노력파",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 5996,
   "offset": 4378873,
   "text": "고독",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 5997,
   "offset": 4378878,
   "text": "용감",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 5998,
   "offset": 4378883,
   "text": "고접",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 5999,
   "offset": 4378888,
   "text": "등석",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 6000,
   "offset": 4378893,
   "text": "버버",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 6001,
   "offset": 4378898,
   "text": "고분",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 6002,
   "offset": 4378903,
   "text": "느긋",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 6003,
   "offset": 4378908,
   "text": "장난",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 6004,
   "offset": 4378913,
   "text": "덜렁",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 6005,
   "offset": 4378918,
   "text": "외겁",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 6006,
   "offset": 4378923,
   "text": "성급",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 6007,
   "offset": 4378928,
   "text": "성실",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 6008,
   "offset": 4378933,
   "text": "쾌활",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 6009,
   "offset": 4378938,
   "text": "순진",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 6010,
   "offset": 4378943,
   "text": "소는",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 6011,
   "offset": 4378948,
   "text": "대범",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 6012,
   "offset": 4378953,
   "text": "냉정",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 6013,
   "offset": 4378958,
   "text": "수줍",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 6014,
   "offset": 4378963,
   "text": "무심",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 6015,
   "offset": 4378968,
   "text": "온화",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 6016,
   "offset": 4378973,
   "text": "먐전",
