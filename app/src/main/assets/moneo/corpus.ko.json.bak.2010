   "offset": 4066747,
   "text": "륜",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 3858,
   "offset": 4066751,
   "text": "꽝꽤끊끌느",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3859,
   "offset": 4066763,
   "text": "댕",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 3860,
   "offset": 4066766,
   "text": "다당밀밈띨득",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 3861,
   "offset": 4066779,
   "text": "겹듀된",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3862,
