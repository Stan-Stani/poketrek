   "id": 2914,
   "offset": 4055255,
   "text": "{var:02}\n넣비공끓{var:03}!",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 2916,
   "offset": 4055272,
   "text": "{var:02}몬{var:03}\n체제넛선껌!",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 2918,
   "offset": 4055297,
   "text": "{var:02}\n뚝잠돼□",
   "unknown": 1,
   "hangul": 3
  },
  {
   "id": 2919,
   "offset": 4055311,
   "text": "케",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 2920,
   "offset": 4055313,
   "text": "{var:02}\n캅□돼□",
   "unknown": 2,
   "hangul": 2
  },
  {
   "id": 2921,
   "offset": 4055327,
   "text": "케",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 2922,
   "offset": 4055329,
   "text": "경곁다당몬겊\n간끔넌널끼!",
   "unknown": 0,
   "hangul": 11
  },
  {
   "id": 2923,
   "offset": 4055357,
   "text": "란치자우요!",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 2924,
   "offset": 4055364,
   "text": "깐콘다당\n곧교간끔경곁",
   "unknown": 0,
   "hangul": 10
  },
  {
   "id": 2925,
   "offset": 4055386,
   "text": "등",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 2926,
   "offset": 4055388,
   "text": "□곧교\n간끔경곁",
   "unknown": 1,
   "hangul": 6
  },
  {
   "id": 2927,
   "offset": 4055404,
   "text": "마세등",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 2928,
   "offset": 4055408,
   "text": "간끔궂곽덥\n경곁다당",
   "unknown": 0,
   "hangul": 9
  },
  {
   "id": 2929,
   "offset": 4055428,
   "text": "피키마세등",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 2930,
   "offset": 4055435,
   "text": "곧교\n간끔넘공깐다당",
   "unknown": 0,
   "hangul": 9
  },
  {
   "id": 2931,
   "offset": 4055456,
   "text": "토루코토제피키마세등",
   "unknown": 0,
   "hangul": 10
  },
  {
   "id": 2932,
   "offset": 4055468,
   "text": "곧교간끔궂곽덥\n경곁",
   "unknown": 0,
   "hangul": 9
  },
  {
   "id": 2933,
   "offset": 4055488,
   "text": "키마세등",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 2934,
   "offset": 4055493,
   "text": "간관곽덥나눈몬\n다당놉놋",
   "unknown": 0,
   "hangul": 11
  },
  {
   "id": 2935,
   "offset": 4055520,
   "text": "아리마세등",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 2936,
   "offset": 4055527,
   "text": "깐간관다당□끼",
   "unknown": 1,
   "hangul": 6
  },
  {
   "id": 2937,
   "offset": 4055544,
   "text": "포켓몬을륜라주세요",
   "unknown": 0,
   "hangul": 9
  },
  {
   "id": 2938,
   "offset": 4055560,
   "text": "어디로이동할까?",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 2939,
   "offset": 4055573,
   "text": "묠헌덜콘다당?",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 2941,
   "offset": 4055589,
   "text": "덜콘다당걸검갸?",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 2942,
   "offset": 4055605,
   "text": "닐덜콘다당뿐깊?",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 2943,
   "offset": 4055621,
   "text": "{var:02}뭘할까?",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 2944,
   "offset": 4055631,
   "text": "던깊를꺄몬긋!",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 2945,
   "offset": 4055645,
   "text": "깠환간끔검",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 2946,
   "offset": 4055656,
   "text": "걸검끓□□멘",
   "unknown": 2,
   "hangul": 4
  },
  {
   "id": 2947,
   "offset": 4055669,
   "text": "스",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 2948,
   "offset": 4055671,
   "text": "깠간끔걸검",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 2949,
   "offset": 4055683,
   "text": "할림욱끔",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 2950,
   "offset": 4055692,
   "text": "루?",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 2951,
   "offset": 4055695,
   "text": "넘넋욱끔",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 2952,
   "offset": 4055704,
   "text": "소지품을어떻게?",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 2953,
   "offset": 4055718,
   "text": "깠환간끔뜻넌!",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 2954,
   "offset": 4055732,
   "text": "협겔덜콘다당?",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 2956,
   "offset": 4055748,
   "text": "냇냈간혹……",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 2957,
   "offset": 4055759,
   "text": "등……",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 2958,
   "offset": 4055763,
   "text": "던깊3햇다당",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 2959,
   "offset": 4055776,
   "text": "깊냅괃몬다당!",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 2960,
   "offset": 4055791,
   "text": "깊냅괃몬젤짐",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 2961,
   "offset": 4055804,
   "text": "스",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 2962,
   "offset": 4055806,
   "text": "□뎌끓간갔끼!",
   "unknown": 1,
   "hangul": 5
  },
  {
   "id": 2963,
   "offset": 4055821,
   "text": "곽발먹뽈낚헉",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 2964,
   "offset": 4055834,
   "text": "다당힐화갱횟",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 2965,
   "offset": 4055850,
   "text": "갱횟다당겁것",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 2966,
   "offset": 4055864,
   "text": "이",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 2967,
   "offset": 4055866,
   "text": "던깊2콘",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 2968,
   "offset": 4055874,
   "text": "이마세등",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 2969,
   "offset": 4055879,
   "text": "꿈꽁!",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 2970,
   "offset": 4055885,
   "text": "트타노시모우!",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 2971,
   "offset": 4055894,
   "text": "뚱꺼교검끓!",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 2972,
   "offset": 4055907,
   "text": "간끔검",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 2973,
   "offset": 4055914,
   "text": "간끔넋",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 2974,
   "offset": 4055921,
   "text": "□군",
   "unknown": 1,
   "hangul": 1
  },
  {
   "id": 2975,
   "offset": 4055927,
   "text": "□핌",
   "unknown": 1,
   "hangul": 1
  },
  {
   "id": 2977,
   "offset": 4055938,
   "text": "게낳",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 2978,
   "offset": 4055944,
   "text": "간끔게",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 2979,
   "offset": 4055951,
   "text": "□멱!",
   "unknown": 1,
   "hangul": 1
  },
  {
   "id": 2981,
   "offset": 4055959,
   "text": "□간멱",
   "unknown": 1,
   "hangul": 2
  },
  {
   "id": 2982,
   "offset": 4055967,
   "text": "□멱끓",
   "unknown": 1,
   "hangul": 2
  },
  {
   "id": 2983,
   "offset": 4055975,
   "text": "오키드『자신의포켓몬을\n자세히아는것도중요하단다!\n\n",
   "unknown": 0,
   "hangul": 22
  },
  {
   "id": 2984,
   "offset": 4056009,
   "text": "모",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 2985,
   "offset": 4056011,
   "text": "이건…{var:01}의포켓몬을\n나타내고있는거지\n\n이걸고르면포켓몬들의\n능력이나쓸수있는기술의\n\n정보를얻을수있어\n\n도구를쓸때도\n여기에서포켓몬을고르는거지\n\n",
   "unknown": 0,
   "hangul": 63
  },
  {
   "id": 2986,
   "offset": 4056118,
   "text": "도자",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 2987,
   "offset": 4056123,
   "text": "끔를려놔",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 2988,
   "offset": 4056133,
   "text": "끔눗공엠버",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 2989,
   "offset": 4056145,
   "text": "교놈같낮함",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 2990,
   "offset": 4056157,
   "text": "끔갠꼴숙딧",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 2991,
   "offset": 4056168,
   "text": "□여많존",
   "unknown": 1,
   "hangul": 3
  },
  {
   "id": 2992,
   "offset": 4056177,
   "text": "끔겪첵숙딧",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 2993,
   "offset": 4056189,
   "text": "몬같□되",
   "unknown": 1,
   "hangul": 3
  },
  {
   "id": 2994,
   "offset": 4056198,
   "text": "끔□띨놈문",
   "unknown": 1,
   "hangul": 4
  },
  {
   "id": 2995,
   "offset": 4056210,
   "text": "고깠환두높",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 2996,
   "offset": 4056221,
   "text": "짧□다당",
   "unknown": 1,
   "hangul": 3
  },
  {
   "id": 2997,
   "offset": 4056230,
   "text": "베스",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 2998,
   "offset": 4056233,
   "text": "할림냇냈",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 2999,
   "offset": 4056242,
   "text": "루",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 3000,
   "offset": 4056244,
   "text": "궁쿼멱덤",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3001,
   "offset": 4056253,
   "text": "이쿠",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3002,
   "offset": 4056256,
   "text": "보견깠환\n힐화공{var:02}?",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 3003,
   "offset": 4056275,
   "text": "루?",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 3004,
   "offset": 4056278,
   "text": "공몹미몬\n{var:02}?",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3005,
   "offset": 4056291,
   "text": "냐몬의-안스루?",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 3006,
   "offset": 4056301,
   "text": "공격",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3007,
   "offset": 4056306,
   "text": "방어",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3008,
   "offset": 4056311,
   "text": "특공",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3009,
   "offset": 4056316,
   "text": "특방",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3010,
   "offset": 4056321,
   "text": "민첩",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3012,
   "offset": 4056329,
   "text": "깐콘다당간끔넉넋",
   "unknown": 0,
   "hangul": 8
  },
  {
   "id": 3013,
   "offset": 4056348,
   "text": "케",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 3014,
   "offset": 4056350,
   "text": "겔겜넉넋?",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3016,
   "offset": 4056362,
   "text": "간경곁{var:02}\n건걷끗?",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 3017,
   "offset": 4056379,
   "text": "요로시이피스카?",
   "unknown": 0,
   "hangul": 7
  },
  {
   "id": 3018,
   "offset": 4056389,
   "text": "겔겜곽넌끗?",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3019,
   "offset": 4056402,
   "text": "접속끊기",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3020,
   "offset": 4056411,
   "text": "럽학",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3021,
   "offset": 4056417,
   "text": "도구관련",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3022,
   "offset": 4056426,
   "text": "메일박스",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3023,
   "offset": 4056434,
   "text": "도구를맡긴다",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 3024,
   "offset": 4056444,
   "text": "도구를찾는다",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 3025,
   "offset": 4056453,
   "text": "늬뎨젤짐",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3026,
   "offset": 4056463,
   "text": "컴퓨터에\n도구를보관",
   "unknown": 0,
   "hangul": 9
  },
  {
   "id": 3027,
   "offset": 4056480,
   "text": "컴퓨터의\n도구를엽니다",
   "unknown": 0,
   "hangul": 10
  },
  {
   "id": 3028,
   "offset": 4056496,
   "text": "늬뎨둘둠문\n뚱깊몬겹겼",
   "unknown": 0,
   "hangul": 10
  },
  {
   "id": 3029,
   "offset": 4056518,
   "text": "테마스",
   "unknown": 0,
   "hangul": 3
  },
  {
   "id": 3030,
   "offset": 4056522,
   "text": "아무것도없다!\n\n",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 3031,
   "offset": 4056535,
   "text": "곧교\n간끔함띨친□",
   "unknown": 1,
   "hangul": 7
  },
  {
   "id": 3032,
   "offset": 4056554,
   "text": "{var:02}\n몇개포낼까?",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3033,
   "offset": 4056569,
   "text": "{var:02}\n{var:03}개포냈다",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3034,
   "offset": 4056585,
   "text": "겉□닥",
   "unknown": 1,
   "hangul": 2
  },
  {
   "id": 3035,
   "offset": 4056592,
   "text": "무",
   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 3036,
   "offset": 4056594,
   "text": "화공친□",
   "unknown": 1,
   "hangul": 3
  },
  {
   "id": 3037,
   "offset": 4056603,
   "text": "헌다당젤짐",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3038,
   "offset": 4056614,
   "text": "메일은1개도없습니다\n\n",
   "unknown": 0,
   "hangul": 9
  },
  {
   "id": 3039,
   "offset": 4056632,
   "text": "곽{var:02}발먹\n뽈낚헉?",
   "unknown": 0,
   "hangul": 6
  },
  {
   "id": 3040,
   "offset": 4056650,
   "text": "닐□닥실뜨\n건걷끗?",
   "unknown": 1,
   "hangul": 7
  },
  {
   "id": 3041,
   "offset": 4056669,
   "text": "이피스카?",
   "unknown": 0,
   "hangul": 4
  },
  {
   "id": 3042,
   "offset": 4056675,
   "text": "친□□끓!",
   "unknown": 2,
   "hangul": 2
  },
  {
   "id": 3044,
   "offset": 4056690,
   "text": "문□□닥몬발먹\n겔띨친□끓",
   "unknown": 3,
   "hangul": 9
  },
  {
   "id": 3045,
   "offset": 4056718,
   "text": "도구를\n열음",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3046,
   "offset": 4056728,
   "text": "포냄",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3047,
   "offset": 4056733,
   "text": "돌아갑니다。",
   "unknown": 0,
   "hangul": 5
  },
  {
   "id": 3048,
   "offset": 4056742,
   "text": "마스",
   "unknown": 0,
   "hangul": 2
  },
  {
   "id": 3049,
   "offset": 4056745,
   "text": "왠",
   "unknown": 0,
   "hangul": 1
  },
