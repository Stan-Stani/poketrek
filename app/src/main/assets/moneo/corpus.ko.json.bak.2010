   "unknown": 0,
   "hangul": 1
  },
  {
   "id": 4975,
   "offset": 4280971,
   "text": "딨심몬려\n튀견몬\n꼴□려",
   "unknown": 1,
   "hangul": 9
  },
  {
   "id": 4976,
   "offset": 4280994,
   "text": "얻툼\n같든건겔더덩",
   "unknown": 0,
   "hangul": 8
  },
  {
