# ROMs — never committed (copyright + size). Loaded at runtime via Storage Access Framework picker.
*.gba
*.gb
*.gbc
*.sav
*.savestate

# Savestate fixtures pulled off-device for instrumentation tests (mirror app's slot_*.bin/.meta naming)
app/src/androidTest/assets/*.bin
app/src/androidTest/assets/*.meta

# Android / Gradle
.gradle/
build/
local.properties
.cxx/
*.iml
.idea/
captures/
.externalNativeBuild/

# Gradle wrapper jar tracked, but caches not
**/.gradle/

# macOS
.DS_Store

# mGBA build artifacts (in case anything escapes the build/ dirs)
third_party/mgba/build/
.moneo-artifacts/

# Python venvs (mining/tooling)
.venv*/
__pycache__/
